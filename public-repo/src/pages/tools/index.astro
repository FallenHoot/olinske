---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { toolsRegistry } from '../../data/tools';
---

<BaseLayout title="Tools | Olinske" description="Interactive tools by Zach Olinske for architecture, reliability, and operating decisions.">
  <main class="site-shell">
    <section class="container tools-shell">
      <p class="eyebrow">Interactive Workspace</p>
      <h1 class="hero-title">Tools</h1>
      <p class="hero-subtitle">A single place for practical tools and assessments. This starts with BCDR and will expand as new utilities are released.</p>

      <div class="tools-grid" role="list" aria-label="Published and planned tools">
        {toolsRegistry.map((tool) => (
          <article class="tool-card" role="listitem">
            <p class={`tool-status ${tool.status === 'Live' ? 'is-live' : 'is-coming'}`}>{tool.status}</p>
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            {tool.href.trim() === ''
              ? <span class="tool-link disabled" aria-disabled="true">Not published yet</span>
              : <a class="tool-link" href={tool.href}>Open tool</a>}
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .tools-shell {
    display: grid;
    gap: 1rem;
  }

  .tools-grid {
    display: grid;
    gap: 0.95rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
  }

  .tool-card {
    border: 1px solid var(--border);
    background: linear-gradient(165deg, color-mix(in srgb, var(--surface) 92%, transparent), color-mix(in srgb, var(--surface-2) 85%, transparent));
    border-radius: 16px;
    padding: 1rem;
    box-shadow: var(--shadow);
    display: grid;
    gap: 0.7rem;
  }

  .tool-card h2 {
    margin: 0;
    font-size: 1.05rem;
    font-family: var(--font-display);
  }

  .tool-card p {
    margin: 0;
    color: var(--muted);
  }

  .tool-status {
    margin: 0;
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    width: fit-content;
    border-radius: 999px;
    padding: 0.2rem 0.55rem;
    border: 1px solid var(--border);
  }

  .tool-status.is-live {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
    background: color-mix(in srgb, var(--accent) 11%, transparent);
  }

  .tool-status.is-coming {
    color: var(--muted);
  }

  .tool-link {
    width: fit-content;
    font-family: var(--font-display);
    font-size: 0.9rem;
    text-decoration: none;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 0.42rem 0.7rem;
    color: var(--text);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
  }

  .tool-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .tool-link.disabled {
    opacity: 0.7;
    cursor: not-allowed;
  }
</style>
