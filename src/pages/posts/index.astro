---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const allPosts = (
  await getCollection('posts', ({ data }) =>
    data.status === 'published' || data.status === 'scheduled'
  )
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const selectedCategory = (Astro.url.searchParams.get('category') || '').trim().toLowerCase();
const selectedQuery = (Astro.url.searchParams.get('q') || '').trim();

const normalizeText = (value?: string) =>
  (value || '')
    .toLowerCase()
    .replace(/[^a-z0-9\s]/g, ' ')
    .replace(/\s+/g, ' ')
    .trim();

const STOP_WORDS = new Set([
  'a', 'an', 'and', 'are', 'as', 'at', 'be', 'by', 'for', 'from', 'in', 'is', 'it',
  'not', 'of', 'on', 'or', 'that', 'the', 'this', 'to', 'was', 'were', 'with',
]);

const parseQueryTerms = (query: string) => {
  const normalizedQuery = normalizeText(query);
  const rawTerms = normalizedQuery
    .split(/\s+/)
    .map((t) => t.trim())
    .filter(Boolean);

  const meaningfulTerms = rawTerms.filter((term) => !STOP_WORDS.has(term));
  return {
    normalizedQuery,
    terms: meaningfulTerms.length > 0 ? meaningfulTerms : rawTerms,
  };
};

const escapeRegExp = (value: string) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

const containsWholeWord = (text: string, term: string) => {
  const pattern = new RegExp(`(^|\\s)${escapeRegExp(term)}(\\s|$)`);
  return pattern.test(text);
};

const countWholeWordOccurrences = (text: string, term: string) => {
  const pattern = new RegExp(`(^|\\s)${escapeRegExp(term)}(?=\\s|$)`, 'g');
  const matches = text.match(pattern);
  return matches ? matches.length : 0;
};

const matchesCategory = (tags: string[], category: string) => {
  if (!category) return true;
  const categoryKeyword = category.replace(/-/g, ' ').toLowerCase();
  return tags.some((tag) => tag.includes(categoryKeyword) || categoryKeyword.includes(tag));
};

const matchesQuery = (
  title: string,
  description: string,
  tags: string[],
  body: string,
  query: string,
) => {
  if (!query) return true;
  const haystack = normalizeText([title, description, tags.join(' '), body].join(' '));
  const { normalizedQuery, terms } = parseQueryTerms(query);
  if (!terms.length) return true;

  if (normalizedQuery.length >= 6 && haystack.includes(normalizedQuery)) {
    return true;
  }

  return terms.every((term) => containsWholeWord(haystack, term));
};

const queryScore = (
  title: string,
  description: string,
  tags: string[],
  body: string,
  query: string,
) => {
  if (!query) return 0;

  const normalizedTitle = normalizeText(title);
  const normalizedDescription = normalizeText(description);
  const normalizedTags = normalizeText(tags.join(' '));
  const normalizedBody = normalizeText(body);
  const parsed = parseQueryTerms(query);
  const normalizedQuery = parsed.normalizedQuery;
  const terms = parsed.terms;

  let score = 0;
  if (normalizedQuery.length >= 3) {
    if (normalizedTitle === normalizedQuery) score += 4000;
    if (normalizedTitle.startsWith(normalizedQuery)) score += 2500;
  }

  if (normalizedQuery.length >= 3) {
    if (normalizedTitle.includes(normalizedQuery)) score += 140;
    if (normalizedDescription.includes(normalizedQuery)) score += 100;
    if (normalizedTags.includes(normalizedQuery)) score += 85;
    if (normalizedBody.includes(normalizedQuery)) score += 40;
  }

  terms.forEach((term) => {
    const titleCount = countWholeWordOccurrences(normalizedTitle, term);
    const descriptionCount = countWholeWordOccurrences(normalizedDescription, term);
    const tagCount = countWholeWordOccurrences(normalizedTags, term);
    const bodyCount = countWholeWordOccurrences(normalizedBody, term);

    if (titleCount > 0) {
      score += 2000;
      score += titleCount * 180;
    }

    score += descriptionCount * 42;
    score += tagCount * 55;
    score += bodyCount * 12;
  });

  return score;
};

const filteredPosts = allPosts
  .map((post) => {
    const tags = (post.data.tags ?? []).map((tag) => tag.toLowerCase());
    const inCategory = matchesCategory(tags, selectedCategory);
    const inQuery = matchesQuery(post.data.title, post.data.description ?? '', tags, post.body ?? '', selectedQuery);
    return {
      post,
      inCategory,
      inQuery,
      score: queryScore(post.data.title, post.data.description ?? '', tags, post.body ?? '', selectedQuery),
    };
  })
  .filter((entry) => entry.inCategory && entry.inQuery)
  .sort((a, b) => {
    if (selectedQuery && a.score !== b.score) return b.score - a.score;
    return b.post.data.publishDate.valueOf() - a.post.data.publishDate.valueOf();
  })
  .map((entry) => entry.post);

const estimateReadTime = (body?: string) => {
  const words = (body ?? '').trim().split(/\s+/).filter(Boolean).length;
  return Math.max(1, Math.ceil(words / 220));
};

---

<BaseLayout title="Articles | Olinske" description="Technical architecture, AI strategy, and cloud leadership essays.">
  <main class="container site-shell">

    <section class="hero-panel fade-in">
      <p class="eyebrow" id="posts-active-topic">All Topics</p>
      <h1 class="hero-title">Technical<br>Articles</h1>
      <p class="hero-subtitle" id="posts-subtitle">Engineering notes, cloud architecture patterns, and AI operating guidance.</p>

      <form class="posts-filter-bar" id="posts-filter-form" action="/posts/" method="get" role="search" aria-label="Filter articles by topic and keyword">
        <input
          id="posts-search-input"
          class="posts-search-input"
          type="search"
          name="q"
          value={selectedQuery}
          placeholder="Search keywords, topics, or phrases"
          aria-label="Search article keywords"
        />
        <input id="posts-category-input" type="hidden" name="category" value={selectedCategory} />
        <button type="submit" class="btn-link">Search</button>
        <a id="posts-clear-link" class="btn-link btn-muted" href="/posts/" hidden>Clear filters</a>
      </form>
    </section>

    <section aria-label="Post grid" class="v-grid">
      {filteredPosts.map((post) => (
        <a
          class="v-card scroll-reveal"
          href={`/posts/${post.id.replace(/\.md$/, '')}/`}
          data-title={post.data.title.toLowerCase()}
          data-description={(post.data.description ?? '').toLowerCase()}
          data-tags={(post.data.tags ?? []).join('||').toLowerCase()}
          data-body={(post.body ?? '').toLowerCase()}
        >
          <div class="v-card-thumb" aria-hidden="true"></div>
          <div class="v-card-body">
            <p class="v-card-meta">
              <span>{post.data.publishDate.toISOString().slice(0, 10)}</span>
              <span>READ: {estimateReadTime(post.body)} MIN</span>
            </p>
            <div class="tag-row">
              {(post.data.tags ?? []).slice(0, 3).map((tag) => (
                <span class="tag-chip">{tag}</span>
              ))}
            </div>
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </div>
        </a>
      ))}

      <a class="v-card" id="posts-empty-card" href="#" hidden>
        <div class="v-card-thumb" aria-hidden="true"></div>
        <div class="v-card-body">
          <p class="v-card-meta">
            <span>RESULTS</span>
            <span>0</span>
          </p>
          <h3>No posts match these filters.</h3>
          <p>Try fewer keywords, another topic, or clear filters.</p>
        </div>
      </a>
    </section>

  </main>

  <!-- Scroll-reveal via IntersectionObserver — no external dep needed -->
  <script>
    const items = Array.from(document.querySelectorAll('.scroll-reveal'));
    const cards = Array.from(document.querySelectorAll('.v-grid .v-card.scroll-reveal'));
    const searchInput = document.getElementById('posts-search-input');
    const categoryInput = document.getElementById('posts-category-input');
    const clearLink = document.getElementById('posts-clear-link');
    const subtitle = document.getElementById('posts-subtitle');
    const topicLabel = document.getElementById('posts-active-topic');
    const emptyCard = document.getElementById('posts-empty-card');
    const postGrid = document.querySelector('.v-grid');

    const params = new URLSearchParams(window.location.search);
    const category = (params.get('category') || '').trim();
    const query = (params.get('q') || '').trim();

    if (searchInput) searchInput.value = query;
    if (categoryInput) categoryInput.value = category;

    function normalizeCategoryLabel(value) {
      if (!value) return 'All Topics';
      return value
        .replace(/-/g, ' ')
        .split(' ')
        .filter(Boolean)
        .map((word) => word.charAt(0).toUpperCase() + word.slice(1))
        .join(' ');
    }

    function matchesCategory(card, selectedCategory) {
      if (!selectedCategory) return true;
      const categoryKeyword = selectedCategory.replace(/-/g, ' ').toLowerCase();
      const tags = (card.getAttribute('data-tags') || '').split('||').map((t) => t.trim()).filter(Boolean);
      return tags.some((tag) => tag.includes(categoryKeyword) || categoryKeyword.includes(tag));
    }

    const STOP_WORDS = new Set([
      'a', 'an', 'and', 'are', 'as', 'at', 'be', 'by', 'for', 'from', 'in', 'is', 'it',
      'not', 'of', 'on', 'or', 'that', 'the', 'this', 'to', 'was', 'were', 'with',
    ]);

    const normalizeText = (value) =>
      value
        .toLowerCase()
        .replace(/[^a-z0-9\s]/g, ' ')
        .replace(/\s+/g, ' ')
        .trim();

    const parseQueryTerms = (query) => {
      const normalizedQuery = normalizeText(query);
      const rawTerms = normalizedQuery
        .split(/\s+/)
        .map((t) => t.trim())
        .filter(Boolean);
      const meaningfulTerms = rawTerms.filter((term) => !STOP_WORDS.has(term));
      return {
        normalizedQuery,
        terms: meaningfulTerms.length > 0 ? meaningfulTerms : rawTerms,
      };
    };

    const escapeRegExp = (value) => value.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');

    const containsWholeWord = (text, term) => {
      const pattern = new RegExp(`(^|\\s)${escapeRegExp(term)}(\\s|$)`);
      return pattern.test(text);
    };

    const countWholeWordOccurrences = (text, term) => {
      const pattern = new RegExp(`(^|\\s)${escapeRegExp(term)}(?=\\s|$)`, 'g');
      const matches = text.match(pattern);
      return matches ? matches.length : 0;
    };

    function matchesQuery(card, selectedQuery) {
      if (!selectedQuery) return true;

      const countWholeWordOccurrences = (text, term) => {
        const pattern = new RegExp(`(^|\\s)${escapeRegExp(term)}(?=\\s|$)`, 'g');
        const matches = text.match(pattern);
        return matches ? matches.length : 0;
      };

      const text = [
        card.getAttribute('data-title') || '',
        card.getAttribute('data-description') || '',
        card.getAttribute('data-tags') || '',
        card.getAttribute('data-body') || '',
      ].join(' ');

      const normalizedText = normalizeText(text);

      const { normalizedQuery, terms } = parseQueryTerms(selectedQuery);
      if (!terms.length) return true;

      if (normalizedQuery.length >= 6 && normalizedText.includes(normalizedQuery)) {
        return true;
      }

      return terms.every((term) => containsWholeWord(normalizedText, term));
    }

    function queryScore(card, selectedQuery) {
      if (!selectedQuery) return 0;

      const normalizedTitle = normalizeText(card.getAttribute('data-title') || '');
      const normalizedDescription = normalizeText(card.getAttribute('data-description') || '');
      const normalizedTags = normalizeText((card.getAttribute('data-tags') || '').replace(/\|\|/g, ' '));
      const normalizedBody = normalizeText(card.getAttribute('data-body') || '');
      const { normalizedQuery, terms } = parseQueryTerms(selectedQuery);

      let score = 0;
      if (normalizedQuery.length >= 3) {
        if (normalizedTitle === normalizedQuery) score += 4000;
        if (normalizedTitle.startsWith(normalizedQuery)) score += 2500;
      }

      if (normalizedQuery.length >= 3) {
        if (normalizedTitle.includes(normalizedQuery)) score += 140;
        if (normalizedDescription.includes(normalizedQuery)) score += 100;
        if (normalizedTags.includes(normalizedQuery)) score += 85;
        if (normalizedBody.includes(normalizedQuery)) score += 40;
      }

      terms.forEach((term) => {
        const titleCount = countWholeWordOccurrences(normalizedTitle, term);
        const descriptionCount = countWholeWordOccurrences(normalizedDescription, term);
        const tagCount = countWholeWordOccurrences(normalizedTags, term);
        const bodyCount = countWholeWordOccurrences(normalizedBody, term);

        if (titleCount > 0) {
          score += 2000;
          score += titleCount * 180;
        }

        score += descriptionCount * 42;
        score += tagCount * 55;
        score += bodyCount * 12;
      });

      return score;
    }

    function applyFilters() {
      const ranked = [];
      cards.forEach((card, index) => {
        const show = matchesCategory(card, category) && matchesQuery(card, query);
        card.hidden = !show;
        if (show) {
          ranked.push({
            card,
            score: queryScore(card, query),
            index,
          });
        }
      });

      if (query && postGrid) {
        ranked
          .sort((a, b) => {
            if (a.score !== b.score) return b.score - a.score;
            return a.index - b.index;
          })
          .forEach((entry) => {
            postGrid.insertBefore(entry.card, emptyCard);
          });
      }

      const visibleCount = ranked.length;

      if (emptyCard) emptyCard.hidden = visibleCount !== 0;

      const activeTopic = normalizeCategoryLabel(category);
      if (topicLabel) topicLabel.textContent = activeTopic;

      if (subtitle) {
        if (category || query) {
          const qualifiers = [];
          if (category) qualifiers.push(`topic: ${activeTopic}`);
          if (query) qualifiers.push(`keywords: "${query}"`);
          subtitle.textContent = `Filtered by ${qualifiers.join(' | ')}. ${visibleCount} post${visibleCount !== 1 ? 's' : ''} found.`;
        } else {
          subtitle.textContent = 'Engineering notes, cloud architecture patterns, and AI operating guidance.';
        }
      }

      if (clearLink) {
        const hasFilters = Boolean(category || query);
        clearLink.hidden = !hasFilters;
        clearLink.href = '/posts/';
      }
    }

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );

    items.forEach((el, i) => {
      el.style.transitionDelay = `${i * 55}ms`;
      observer.observe(el);
    });

    applyFilters();
  </script>
</BaseLayout>
