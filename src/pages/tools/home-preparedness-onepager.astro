---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Home Preparedness One-Pager | Tools | Olinske"
  description="Generate a printable home preparedness one-pager in Norwegian or English with evacuation triggers, go-box checklist, and local contact fields."
>
  <main class="site-shell">
    <section class="container prep-shell">
      <p class="eyebrow">Preparedness Tool</p>
      <h1 class="hero-title">Home Preparedness One-Pager</h1>
      <p class="hero-subtitle">
        Print-ready household checklist based on DSB preparedness guidance. Switch between Norwegian and English,
        fill local details, and print in A4 format.
      </p>

      <div class="controls" data-pagefind-ignore>
        <div class="lang-switch" role="group" aria-label="Language selector">
          <button id="btn-no" class="lang-btn is-active" type="button" aria-pressed="true">Norsk</button>
          <button id="btn-en" class="lang-btn" type="button" aria-pressed="false">English</button>
        </div>
        <button id="pdf-btn" class="print-btn" type="button" data-label-no="Last ned PDF" data-label-en="Download PDF">Last ned PDF</button>
        <button id="print-btn" class="print-btn" type="button" data-label-no="Skriv ut A4" data-label-en="Print A4">Skriv ut A4</button>
      </div>

      <article id="sheet-no" class="sheet poster" lang="no">
        <h2>HJEMMEBEREDSKAP - 72 TIMER</h2>
        <p class="subtitle">En enkel sjekkliste for alle hjem</p>

        <div class="top-grid">
        <section class="block icon-alert">
          <h3>LEAVE NOW / EVAKUER NÅR</h3>
          <ul class="checklist">
            <li><input type="checkbox" /> Myndighetene gir evakueringsordre</li>
            <li><input type="checkbox" /> Du ser gnister eller gnistregn i området</li>
            <li><input type="checkbox" /> Brann er synlig i nærheten av boligen</li>
            <li><input type="checkbox" /> Røyk/varme gjør det utrygt å bli</li>
          </ul>
          <p class="note">Viktig: Ikke forsink evakuering for å redde eiendeler.</p>
        </section>

        <section class="block block-local">
          <h3>LOKALE OPPLYSNINGER (FYLL INN)</h3>
          <div class="lines">
            <div>Adresse: ______________________________</div>
            <div>Møtepunkt for familien: ______________________________</div>
            <div>Kommunens varslingskanal: ______________________________</div>
            <div>Lokal brann-/beredskapskontakt: ______________________________</div>
            <div>Trygg evakueringsrute: ______________________________</div>
            <div>Reserve møtested utenfor området: ______________________________</div>
          </div>
        </section>
        </div>

        <section class="block icon-housefire">
          <h3>BRANNSIKKERHET I HJEMMET</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Røykvarsler i alle etasjer</li>
            <li><input type="checkbox" /> Brannslukker / husbrannslange</li>
            <li><input type="checkbox" /> Brannteppe på kjøkken</li>
            <li><input type="checkbox" /> Rømningsplan og møtepunkt</li>
            <li><input type="checkbox" /> Lommelykt ved soverom</li>
          </ul>
        </section>

        <section class="block icon-clock">
          <h3>72-TIMERS BEREDSKAP</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Drikkevann for 3 døgn</li>
            <li><input type="checkbox" /> Holdbar mat for 3 døgn</li>
            <li><input type="checkbox" /> Manuell boksåpner</li>
            <li><input type="checkbox" /> Førstehjelpsutstyr og faste medisiner</li>
            <li><input type="checkbox" /> Varme klær og tepper</li>
            <li><input type="checkbox" /> Hygieneartikler</li>
            <li><input type="checkbox" /> Plan for å klare 5 til 7 døgn ved langvarig bortfall</li>
          </ul>
        </section>

        <section class="block icon-radio">
          <h3>STRØM OG KOMMUNIKASJON</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Batteri- eller sveiveradio</li>
            <li><input type="checkbox" /> Utskrevne nødkontakter</li>
            <li><input type="checkbox" /> Ekstra batterier</li>
            <li><input type="checkbox" /> Mobil-ladere samlet på fast plass</li>
            <li><input type="checkbox" /> Ladet powerbank</li>
            <li><input type="checkbox" /> Avtal hvilke offisielle kilder familien stoler på</li>
          </ul>
        </section>

        <section class="block icon-folder">
          <h3>DOKUMENTER OG ØKONOMI</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Kopi av ID og forsikringsinformasjon</li>
            <li><input type="checkbox" /> Viktige helseopplysninger</li>
            <li><input type="checkbox" /> Litt kontanter i små sedler</li>
          </ul>
        </section>

        <section class="block icon-gear">
          <h3>TIDSBASERTE HANDLINGER</h3>
          <ul class="checklist">
            <li><input type="checkbox" /> Steng vann/strøm kun hvis myndigheter instruerer</li>
            <li><input type="checkbox" /> Ikke bruk tid på tekniske tiltak dersom evakuering haster</li>
          </ul>
        </section>

        <section class="block icon-family go-box-block">
          <h3>HUSHOLDNINGSSPESIFIKT<br />GO BOX (FAST TO GRAB)</h3>
          <div class="go-grid">
            <ul class="checklist compact two-col">
              <li><input type="checkbox" /> IDs og dokumentkopier</li>
              <li><input type="checkbox" /> Små kontanter</li>
              <li><input type="checkbox" /> Forsikringsinfo og nøkkelister</li>
              <li><input type="checkbox" /> USB med nøddokumenter</li>
              <li><input type="checkbox" /> Medisinliste + 3-7 dagers nødvendige medisiner</li>
              <li><input type="checkbox" /> Reservepakker</li>
            </ul>
            <ol class="go-steps">
              <li>Bruk en brann- og vannbestandig bærbar koffert.</li>
              <li>Oppbevar nær utgangen, ikke gjemt.</li>
              <li>Merk den tydelig: GO BOX.</li>
              <li>Tildel eierskap: hvem som tar den.</li>
              <li>Øv på en 60-sekunders evakuering inkl. boksen.</li>
              <li>Gjennomgå innhold hver 6. måned.</li>
            </ol>
          </div>
        </section>

        <section class="war-card" aria-label="War preparedness card">
          <div class="war-card-header">KRIGSBEREDSKAPSKORT</div>
          <div class="war-card-grid">
            <div class="war-card-line">
              <span>Nærmeste tilfluktsrom:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Alternativt oppmøtested:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Nærmeste matutdeling / hjelpesenter:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Familiekontakt utenfor området:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Radiofrekvens / lokal kanal:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Offisiell varslingskilde:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Ta med først:</span>
              <strong>ID, medisiner, vann, telefon, GO BOX</strong>
            </div>
          </div>
        </section>

        <section class="helper-card" aria-label="Preparedness helper recommendations">
          <div class="helper-card-header">ANBEFALTE HJELPEVALG</div>
          <div class="helper-grid">
            <div class="helper-block">
              <h4>Beste 2 grab boxes</h4>
              <p><strong>SentrySafe CFW30200</strong><br />1 time ved 1700°F / 927°C, vannbestandig i opptil 72 timer, .36 cu ft, passer A4 og letter flat.</p>
              <p><strong>SentrySafe LCFW30100</strong><br />UL + ETL, opptil 72 timer vann, bærbar keyed chest, .36 cu ft, lett å lagre nær utgang.</p>
            </div>
            <div class="helper-block">
              <h4>Beste sveiveradio</h4>
              <p><strong>Midland ER310</strong><br />Sveiv + sol + oppladbart batteri + AA-backup, NOAA/varsler, lommelykt og USB-nodlading for telefon.</p>
            </div>
            <div class="helper-block">
              <h4>Det andre land gjør bedre</h4>
              <p><strong>Sverige:</strong> totalforsvar og krisesinn.</p>
              <p><strong>Finland/Estland:</strong> tenk 5 til 7 døgn, ikke bare 72 timer.</p>
              <p><strong>Japan:</strong> scenario-tenkning, ikke bare utstyrsliste.</p>
            </div>
          </div>
        </section>

        <p class="emergency">NØDNUMMER: 110 BRANN | 112 POLITI | 113 AMBULANSE</p>
        <p class="source">Kilde: DSB Egenberedskap - https://www.dsb.no/sikkerhverdag/egenberedskap/ <span class="updated">Sist oppdatert: 2026-07-19</span></p>
      </article>

      <article id="sheet-en" class="sheet poster hidden" lang="en">
        <h2>HOME PREPAREDNESS - 72 HOURS</h2>
        <p class="subtitle">A simple household checklist for self-preparedness</p>

        <div class="top-grid">
        <section class="block icon-alert">
          <h3>LEAVE NOW IF</h3>
          <ul class="checklist">
            <li><input type="checkbox" /> Authorities issue an evacuation order</li>
            <li><input type="checkbox" /> You see embers or ember showers nearby</li>
            <li><input type="checkbox" /> Fire is visible near your home</li>
            <li><input type="checkbox" /> Smoke/heat makes it unsafe to stay</li>
          </ul>
          <p class="note">Important: Do not delay evacuation to save property.</p>
        </section>

        <section class="block block-local">
          <h3>LOCAL DETAILS (FILL IN)</h3>
          <div class="lines">
            <div>Address: ______________________________</div>
            <div>Family meeting point: ______________________________</div>
            <div>Emergency alert / municipality channel: ______________________________</div>
            <div>Local emergency contact: ______________________________</div>
            <div>Safe evacuation route: ______________________________</div>
            <div>Backup meeting point outside the area: ______________________________</div>
          </div>
        </section>
        </div>

        <section class="block icon-housefire">
          <h3>FIRE SAFETY AT HOME</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Smoke detectors on all floors</li>
            <li><input type="checkbox" /> Fire extinguisher</li>
            <li><input type="checkbox" /> Fire blanket in the kitchen</li>
            <li><input type="checkbox" /> Escape plan and meeting point</li>
            <li><input type="checkbox" /> Flashlight near bedrooms</li>
          </ul>
        </section>

        <section class="block icon-clock">
          <h3>72-HOUR PREPAREDNESS</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Drinking water for 3 days</li>
            <li><input type="checkbox" /> Food with a long shelf life for 3 days</li>
            <li><input type="checkbox" /> Manual can opener</li>
            <li><input type="checkbox" /> First aid kit and regular medications</li>
            <li><input type="checkbox" /> Warm clothes and blankets</li>
            <li><input type="checkbox" /> Hygiene supplies</li>
            <li><input type="checkbox" /> Plan for 5 to 7 days if disruption lasts longer</li>
          </ul>
        </section>

        <section class="block icon-radio">
          <h3>POWER AND INFORMATION</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Battery or wind-up radio</li>
            <li><input type="checkbox" /> Printed emergency contacts</li>
            <li><input type="checkbox" /> Extra batteries</li>
            <li><input type="checkbox" /> Phone chargers kept in one fixed place</li>
            <li><input type="checkbox" /> Charged power bank</li>
            <li><input type="checkbox" /> Agree on which official information sources to trust</li>
          </ul>
        </section>

        <section class="block icon-folder">
          <h3>DOCUMENTS AND PAYMENTS</h3>
          <ul class="checklist two-col">
            <li><input type="checkbox" /> Copy of ID and insurance information</li>
            <li><input type="checkbox" /> Critical medical details</li>
            <li><input type="checkbox" /> Some cash in small bills</li>
          </ul>
        </section>

        <section class="block icon-gear">
          <h3>TIME-BASED ACTIONS</h3>
          <ul class="checklist">
            <li><input type="checkbox" /> Shut off water or power only if authorities instruct you to do so</li>
            <li><input type="checkbox" /> Do not spend time on technical steps if evacuation is urgent</li>
          </ul>
        </section>

        <section class="block icon-family go-box-block">
          <h3>HOUSEHOLD-SPECIFIC<br />GO BOX (FAST TO GRAB)</h3>
          <div class="go-grid">
            <ul class="checklist compact two-col">
              <li><input type="checkbox" /> IDs and document copies</li>
              <li><input type="checkbox" /> Small cash bills</li>
              <li><input type="checkbox" /> Insurance information and key list</li>
              <li><input type="checkbox" /> USB with emergency documents</li>
              <li><input type="checkbox" /> Medication list plus 3 to 7 days of essential medicine</li>
              <li><input type="checkbox" /> Baby, pet, or disability-related essentials</li>
            </ul>
            <ol class="go-steps">
              <li>Use a portable fire- and water-resistant case.</li>
              <li>Store it near the exit, not hidden away.</li>
              <li>Label it clearly: GO BOX.</li>
              <li>Assign one person to grab it.</li>
              <li>Practice a 60-second evacuation including the box.</li>
              <li>Review contents every 6 months.</li>
            </ol>
          </div>
        </section>

        <section class="war-card" aria-label="War preparedness card">
          <div class="war-card-header">WAR PREPAREDNESS CARD</div>
          <div class="war-card-grid">
            <div class="war-card-line">
              <span>Nearest shelter / protected place:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Alternate meeting point:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Nearest food distribution / aid site:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Out-of-area family contact:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Radio frequency / local channel:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Official alert source:</span>
              <strong>__________________</strong>
            </div>
            <div class="war-card-line">
              <span>Grab first:</span>
              <strong>ID, medicine, water, phone, GO BOX</strong>
            </div>
          </div>
        </section>

        <section class="helper-card" aria-label="Preparedness helper recommendations">
          <div class="helper-card-header">RECOMMENDED PICKS</div>
          <div class="helper-grid">
            <div class="helper-block">
              <h4>Best 2 grab boxes</h4>
              <p><strong>SentrySafe CFW30200</strong><br />1 hour at 1700°F / 927°C, water resistant up to 72 hours, .36 cu ft, holds letter and A4 flat.</p>
              <p><strong>SentrySafe LCFW30100</strong><br />UL + ETL, up to 72 hours water protection, portable keyed chest, .36 cu ft, easy to store near an exit.</p>
            </div>
            <div class="helper-block">
              <h4>Best crank radio</h4>
              <p><strong>Midland ER310</strong><br />Crank + solar + rechargeable battery + AA backup, weather alerts, flashlight, and USB emergency phone charging.</p>
            </div>
            <div class="helper-block">
              <h4>What top countries do better</h4>
              <p><strong>Sweden:</strong> total-defense framing and crisis mindset.</p>
              <p><strong>Finland/Estonia:</strong> think 5 to 7 days, not only 72 hours.</p>
              <p><strong>Japan:</strong> scenario-based action, not just supply lists.</p>
            </div>
          </div>
        </section>

        <p class="emergency">EMERGENCY NUMBERS: 110 FIRE | 112 POLICE | 113 AMBULANCE</p>
        <p class="source">Source: DSB Self-preparedness - https://www.dsb.no/en/safe-everyday-life/self-preparedness/ <span class="updated">English brochure: dsb-egenberedskap-engelsk-web.pdf</span></p>
      </article>
    </section>
  </main>
</BaseLayout>

