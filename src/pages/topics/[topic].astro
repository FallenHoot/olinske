---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { TOPICS, filterPostsByTopic } from '../../data/topicTaxonomy';

export const getStaticPaths = (() => {
  return TOPICS.map((topic) => ({
    params: { topic: topic.slug },
    props: { topic },
  }));
}) satisfies GetStaticPaths;

const { topic } = Astro.props;

const allPosts = (
  await getCollection('posts', ({ data }) =>
    data.status === 'published' || data.status === 'scheduled'
  )
).sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const posts = filterPostsByTopic(allPosts, topic.slug);
---

<BaseLayout title={`${topic.label} | Olinske`} description={topic.description}>
  <main class="container site-shell">
    <section class="hero-panel fade-in">
      <p class="eyebrow">Topic Lens</p>
      <h1 class="hero-title">{topic.label}</h1>
      <p class="hero-subtitle">{topic.description}</p>
      <p class="posts-results-count">{posts.length} article{posts.length === 1 ? '' : 's'} in this topic.</p>
      <div class="posts-filter-links">
        <a class="btn-link" href="/topics/">All topics</a>
        <a class="btn-link" href="/posts/">All posts</a>
      </div>
    </section>

    {posts.length > 0 ? (
      <section class="v-grid" aria-label={`${topic.label} articles`}>
        {posts.map((post) => (
          <a class="v-card scroll-reveal" href={`/posts/${post.data.slug ?? post.id.replace(/\.md$/, '')}/`}>
            <div class="v-card-thumb" aria-hidden="true"></div>
            <div class="v-card-body">
              <p class="v-card-meta">
                <span>{post.data.publishDate.toISOString().slice(0, 10)}</span>
                <span>TOPIC</span>
              </p>
              <div class="tag-row">
                {(post.data.tags ?? []).slice(0, 3).map((tag) => (
                  <span class="tag-chip">{tag}</span>
                ))}
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </div>
          </a>
        ))}
      </section>
    ) : (
      <section class="hero-panel" aria-live="polite">
        <h2>No articles yet</h2>
        <p>This topic is ready, but no published articles map to it yet.</p>
      </section>
    )}
  </main>

  <script>
    const cards = Array.from(document.querySelectorAll('.scroll-reveal'));
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.12 },
    );

    cards.forEach((el, i) => {
      el.style.transitionDelay = `${i * 55}ms`;
      observer.observe(el);
    });
  </script>
</BaseLayout>
