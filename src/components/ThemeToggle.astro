---
// ThemeToggle — simple Light/Dark mode switch with sun/moon icon
---

<button
  id="theme-toggle"
  class="theme-toggle"
  type="button"
  aria-label="Switch to dark mode"
  title="Toggle light or dark mode"
>
  <span class="theme-icon theme-icon-sun" aria-hidden="true">☀</span>
  <span class="theme-icon theme-icon-moon" aria-hidden="true">☾</span>
</button>

<style>
  .theme-icon {
    display: none;
    line-height: 1;
    font-size: 1rem;
  }

  .theme-toggle[data-theme='light'] .theme-icon-sun,
  .theme-toggle[data-theme='dark'] .theme-icon-moon {
    display: inline;
  }
</style>

<script>
  const THEMES = ['light', 'dark'] as const;
  type Theme = typeof THEMES[number];

  function isTheme(value: string | null): value is Theme {
    return value === 'light' || value === 'dark';
  }

  const btn = document.getElementById('theme-toggle');

  if (btn) {
    function applyTheme(next: Theme) {
      document.documentElement.setAttribute('data-theme', next);
      localStorage.setItem('theme', next);
      btn.setAttribute('data-theme', next);
      btn.setAttribute('aria-label', next === 'dark' ? 'Switch to light mode' : 'Switch to dark mode');
    }

    const current = document.documentElement.getAttribute('data-theme');
    const initial: Theme = isTheme(current) ? current : 'light';
    applyTheme(initial);

    btn.addEventListener('click', () => {
      const active = document.documentElement.getAttribute('data-theme');
      const next: Theme = active === 'dark' ? 'light' : 'dark';
      applyTheme(next);
    });
  }
</script>
