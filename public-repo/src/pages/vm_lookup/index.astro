---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { vmLookupMeta } from '../../data/vm_lookup/master-meta';
import { vmSkus } from '../../data/vm_lookup/skus';

const regionLabels = Object.fromEntries(vmLookupMeta.regions.map((region) => [region.code, region.label]));
const regionOptions = vmLookupMeta.regions.map((region) => ({ value: region.code, label: region.label }));
const zonalRegions = vmLookupMeta.regions.filter((region) => region.zones === '1, 2, 3');
const bestCoverageRegion = [...vmLookupMeta.regions].sort((a, b) => b.skuCount - a.skuCount)[0];

const amdRows = vmSkus.filter((row) => row.vendor === 'AMD' && typeof row.pricePerHourUsd === 'number');
const intelRows = vmSkus.filter((row) => row.vendor === 'Intel' && typeof row.pricePerHourUsd === 'number');
const amdAverage = amdRows.length ? amdRows.reduce((total, row) => total + (row.pricePerHourUsd ?? 0), 0) / amdRows.length : 0;
const intelAverage = intelRows.length ? intelRows.reduce((total, row) => total + (row.pricePerHourUsd ?? 0), 0) / intelRows.length : 0;
const amdSavingsPct = amdAverage && intelAverage ? ((intelAverage - amdAverage) / intelAverage) * 100 : 0;
const filteredRegionSummary = vmLookupMeta.regions.map((region) => ({
  ...region,
  isZonal: region.zones === '1, 2, 3',
}));
---

<BaseLayout
  title="Azure VM Size Lookup | Olinske"
  description="Searchable VM size lookup for Nordic and Denmark regions, with v6/v7 availability, AMD versus Intel signals, zone coverage, and migration guidance."
>
  <main class="container site-shell vm-lookup-shell">
    <section class="hero-panel vm-hero">
      <p class="eyebrow">Practical reference</p>
      <h1 class="hero-title">Azure VM Size Lookup</h1>
      <p class="hero-subtitle">
        Start with the answers, then drill into the SKUs. This view highlights the best coverage region, zonal coverage,
        and AMD versus Intel economics before you open the browser.
      </p>
      <p class="hero-source">
        Generated {vmLookupMeta.generatedUtc}. Scope: {vmLookupMeta.notes.scope}. Reported unique SKUs: {vmLookupMeta.totalUniqueSkus}.
      </p>
    </section>

    <section class="decision-strip" aria-label="Key answers">
      <article class="metric-card answer-card">
        <p class="metric-label">Best coverage region</p>
        <p class="metric-value">{bestCoverageRegion.label}</p>
        <p class="metric-subtext">{bestCoverageRegion.skuCount} SKUs available</p>
      </article>
      <article class="metric-card answer-card">
        <p class="metric-label">Zonal regions</p>
        <p class="metric-value">{zonalRegions.length}</p>
        <p class="metric-subtext">Norway East, Sweden Central, Denmark East</p>
      </article>
      <article class="metric-card answer-card">
        <p class="metric-label">AMD versus Intel</p>
        <p class="metric-value">{amdSavingsPct.toFixed(1)}% lower</p>
        <p class="metric-subtext">AMD average is lower in the starter set</p>
      </article>
      <article class="metric-card answer-card">
        <p class="metric-label">Denmark East</p>
        <p class="metric-value">165 SKUs</p>
        <p class="metric-subtext">Launched Jan 2026 with 3 zones</p>
      </article>
    </section>

    <section class="migration-warning" role="note" aria-label="Migration warning">
      <h2>Critical migration warning: v3 to v5 are not in this reference</h2>
      <p>
        This lookup covers v6 and v7 SKUs only. Moving a VM from v3, v4, or v5 to v6 or v7 is not a simple resize operation.
      </p>
      <ul>
        <li>v3 to v5 use SCSI controllers for temporary disks.</li>
        <li>v6 and v7 use NVMe controllers for temporary disks.</li>
        <li>Existing SCSI mappings can break boot or mount behavior after resize.</li>
      </ul>
      <p class="migration-links">
        Recommended paths:
        <a href="https://learn.microsoft.com/azure/migrate/" target="_blank" rel="noreferrer">Azure Migrate</a>
        or
        <a href="https://learn.microsoft.com/azure/virtual-machines/resize-vm" target="_blank" rel="noreferrer">Azure VM resize guidance</a>
      </p>
    </section>

    <section class="reference-grid" aria-label="Regional overview">
      {filteredRegionSummary.map((region) => (
        <article class="reference-card region-card" data-region-target={region.code} tabindex="0" role="button" aria-label={`Filter to ${region.label}`}>
          <p class="metric-label">{region.label}</p>
          <p class="metric-value">{region.skuCount} SKUs</p>
          <p class="metric-subtext">{region.zones} availability zones</p>
          <p class="region-note">{region.launchDate === 'GA' ? 'Generally available' : `Launched ${region.launchDate}`}</p>
        </article>
      ))}
    </section>

    <section class="metrics" aria-label="Filtered summary metrics">
      <article class="metric-card">
        <p class="metric-label">Visible SKUs</p>
        <p id="metric-count" class="metric-value">0</p>
      </article>
      <article class="metric-card">
        <p class="metric-label">Average hourly price</p>
        <p id="metric-price" class="metric-value">$0.000</p>
      </article>
      <article class="metric-card">
        <p class="metric-label">AMD indicative savings</p>
        <p id="metric-savings" class="metric-value">N/A</p>
      </article>
      <article class="metric-card">
        <p class="metric-label">3-zone capable SKUs</p>
        <p id="metric-zones" class="metric-value">0</p>
      </article>
    </section>

    <section class="browser-panel" aria-label="VM browser">
      <div class="browser-head">
        <div>
          <h2>SKU browser</h2>
          <p>Search the starter dataset by SKU, family, processor, generation, or region. Use region cards above for quick filtering.</p>
        </div>
        <div class="browser-actions">
          <button class="action-chip is-active" type="button" data-view-filter="all">All</button>
          <button class="action-chip" type="button" data-view-filter="AMD">AMD</button>
          <button class="action-chip" type="button" data-view-filter="Intel">Intel</button>
          <button class="action-chip" type="button" data-view-filter="v6">v6 only</button>
          <button class="action-chip" type="button" data-view-filter="v7">v7 only</button>
          <button class="action-chip" type="button" data-view-filter="zonal">Zonal only</button>
        </div>
      </div>

      <div class="filter-grid">
        <label>
          Search
          <input id="search" type="search" placeholder="Standard_D4as_v6, Dasv7, Sweden Central" />
        </label>
        <label>
          Processor
          <select id="vendor-filter">
            <option value="all">All</option>
            <option value="AMD">AMD</option>
            <option value="Intel">Intel</option>
          </select>
        </label>
        <label>
          Generation
          <select id="generation-filter">
            <option value="all">All</option>
            <option value="v6">v6</option>
            <option value="v7">v7</option>
          </select>
        </label>
        <label>
          Region
          <select id="region-filter">
            <option value="all">All regions</option>
            {regionOptions.map((region) => <option value={region.value}>{region.label}</option>)}
          </select>
        </label>
        <label>
          Zone profile
          <select id="zone-filter">
            <option value="all">All</option>
            <option value="three">Has 3-zone option</option>
            <option value="nonzonal">Only non-zonal availability</option>
          </select>
        </label>
        <label>
          Sort by
          <select id="sort-filter">
            <option value="price-asc">Price: low to high</option>
            <option value="price-desc">Price: high to low</option>
            <option value="vcpu-asc">vCPU: low to high</option>
            <option value="memory-desc">Memory: high to low</option>
            <option value="name-asc">SKU name: A to Z</option>
          </select>
        </label>
      </div>

      <p id="filter-status" class="filter-status" aria-live="polite"></p>

      <div id="sku-grid" class="sku-grid"></div>
    </section>

    <details class="reference-card raw-matrix" aria-label="Raw availability matrix">
      <summary>Show raw availability matrix</summary>
      <p class="raw-matrix-note">This is the dense reference view for exact regional yes/no mapping.</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>SKU</th>
              <th>Price</th>
              <th>Windows</th>
              <th>Availability matrix</th>
            </tr>
          </thead>
          <tbody id="sku-body"></tbody>
        </table>
      </div>
    </details>

    <section class="reference-grid" aria-label="Migration guide and region notes">
      <article class="reference-card">
        <h2>Migration options for v3 to v5 workloads</h2>
        <ol>
          <li><strong>Azure Migrate</strong>: preferred path for guided discovery and OS preparation during transition.</li>
          <li><strong>Manual preparation</strong>: remove temp disk drive letters in Windows and avoid static SCSI paths in Linux fstab.</li>
          <li><strong>Redeploy and move workload</strong>: cleanest cutover when maintenance windows allow.</li>
        </ol>
      </article>

      <article class="reference-card">
        <h2>Regional highlights</h2>
        <ul>
          <li>Most complete coverage: Sweden Central with 496 SKUs.</li>
          <li>Denmark East launched in January 2026 with 165 SKUs and 3 zones.</li>
          <li>Norway East, Sweden Central, and Denmark East support 3 availability zones.</li>
          <li>Norway West and Sweden South are non-zonal regions.</li>
        </ul>
      </article>
    </section>
  </main>

  <script define:vars={{ vmSkus, regionLabels }}>
    const searchInput = document.querySelector('#search');
    const vendorFilter = document.querySelector('#vendor-filter');
    const generationFilter = document.querySelector('#generation-filter');
    const regionFilter = document.querySelector('#region-filter');
    const zoneFilter = document.querySelector('#zone-filter');
    const sortFilter = document.querySelector('#sort-filter');
    const viewButtons = Array.from(document.querySelectorAll('[data-view-filter]'));
    const regionCards = Array.from(document.querySelectorAll('[data-region-target]'));
    const tableBody = document.querySelector('#sku-body');
    const filterStatus = document.querySelector('#filter-status');
    const skuGrid = document.querySelector('#sku-grid');

    const metricCount = document.querySelector('#metric-count');
    const metricPrice = document.querySelector('#metric-price');
    const metricSavings = document.querySelector('#metric-savings');
    const metricZones = document.querySelector('#metric-zones');

    let activeQuickFilter = 'all';

    function formatCurrency(value) {
      return new Intl.NumberFormat('en-US', {
        style: 'currency',
        currency: 'USD',
        minimumFractionDigits: 3,
      }).format(value);
    }

    function regionMatrixText(row) {
      return Object.keys(regionLabels)
        .map((code) => `${regionLabels[code]}: ${row.regions.includes(code) ? (row.zonalRegions.includes(code) ? '3 zones' : 'non-zonal') : 'not listed'}`)
        .join(' | ');
    }

    function rowMatches(row) {
      const query = searchInput.value.trim().toLowerCase();
      const vendorValue = vendorFilter.value;
      const generationValue = generationFilter.value;
      const regionValue = regionFilter.value;
      const zoneValue = zoneFilter.value;

      const vendorOk = vendorValue === 'all' || row.vendor === vendorValue;
      const generationOk = generationValue === 'all' || row.generation === generationValue;
      const regionOk = regionValue === 'all' || row.regions.includes(regionValue);
      const zoneOk =
        zoneValue === 'all'
        || (zoneValue === 'three' && row.zonalRegions.length > 0)
        || (zoneValue === 'nonzonal' && row.zonalRegions.length === 0);

      if (!query) return vendorOk && generationOk && regionOk && zoneOk;

      const searchable = `${row.sku} ${row.family} ${row.vendor} ${row.generation} ${row.regions.map((code) => regionLabels[code]).join(' ')}`.toLowerCase();
      return searchable.includes(query) && vendorOk && generationOk && regionOk && zoneOk;
    }

    function sortRows(rows) {
      const mode = sortFilter.value;
      const sorted = [...rows];

      if (mode === 'price-asc') sorted.sort((a, b) => (a.pricePerHourUsd ?? 0) - (b.pricePerHourUsd ?? 0));
      else if (mode === 'price-desc') sorted.sort((a, b) => (b.pricePerHourUsd ?? 0) - (a.pricePerHourUsd ?? 0));
      else if (mode === 'vcpu-asc') sorted.sort((a, b) => a.vcpu - b.vcpu || a.memoryGiB - b.memoryGiB);
      else if (mode === 'memory-desc') sorted.sort((a, b) => b.memoryGiB - a.memoryGiB || b.vcpu - a.vcpu);
      else sorted.sort((a, b) => a.sku.localeCompare(b.sku));

      return sorted;
    }

    function renderCards(rows) {
      skuGrid.innerHTML = rows
        .map((row) => {
          const regionBadges = Object.keys(regionLabels)
            .map((code) => {
              if (!row.regions.includes(code)) return `<span class="region-pill is-off">${regionLabels[code]}: -</span>`;
              return `<span class="region-pill">${regionLabels[code]}: ${row.zonalRegions.includes(code) ? '3z' : 'nz'}</span>`;
            })
            .join('');

          return `<article class="sku-card">
            <div class="sku-card-head">
              <div>
                <p class="sku-card-kicker">${row.family} · ${row.vendor} · ${row.generation}</p>
                <h3>${row.sku}</h3>
              </div>
              <span class="sku-price">${formatCurrency(row.pricePerHourUsd ?? 0)}/hr</span>
            </div>
            <div class="sku-card-meta">
              <span>${row.vcpu} vCPU</span>
              <span>${row.memoryGiB} GiB</span>
              <span>${row.zonalRegions.length ? '3-zone capable' : 'non-zonal only'}</span>
            </div>
            <div class="region-chip-row">${regionBadges}</div>
          </article>`;
        })
        .join('');
    }

    function renderRows(rows) {
      tableBody.innerHTML = rows
        .map((row) => {
          const regionBadges = Object.keys(regionLabels)
            .map((code) => {
              if (!row.regions.includes(code)) return `<span class="region-pill is-off">${regionLabels[code]}: -</span>`;
              return `<span class="region-pill">${regionLabels[code]}: ${row.zonalRegions.includes(code) ? '3z' : 'nz'}</span>`;
            })
            .join('');

          return `<tr>
            <td><strong>${row.sku}</strong></td>
            <td>${formatCurrency(row.pricePerHourUsd ?? 0)}</td>
            <td>${formatCurrency(row.windowsPerHourUsd ?? 0)}</td>
            <td class="matrix-col" aria-label="${regionMatrixText(row)}">${regionBadges}</td>
          </tr>`;
        })
        .join('');
    }

    function updateMetrics(rows) {
      metricCount.textContent = String(rows.length);

      if (!rows.length) {
        metricPrice.textContent = '$0.000';
        metricSavings.textContent = 'N/A';
        metricZones.textContent = '0';
        return;
      }

      const prices = rows.map((row) => row.pricePerHourUsd ?? 0);
      const avgPrice = prices.reduce((total, value) => total + value, 0) / prices.length;
      metricPrice.textContent = formatCurrency(avgPrice);

      const amdRows = rows.filter((row) => row.vendor === 'AMD' && typeof row.pricePerHourUsd === 'number');
      const intelRows = rows.filter((row) => row.vendor === 'Intel' && typeof row.pricePerHourUsd === 'number');
      if (amdRows.length && intelRows.length) {
        const amdAverage = amdRows.reduce((total, row) => total + (row.pricePerHourUsd ?? 0), 0) / amdRows.length;
        const intelAverage = intelRows.reduce((total, row) => total + (row.pricePerHourUsd ?? 0), 0) / intelRows.length;
        const delta = ((intelAverage - amdAverage) / intelAverage) * 100;
        metricSavings.textContent = `${delta.toFixed(1)}% lower for AMD`;
      } else {
        metricSavings.textContent = 'N/A';
      }

      metricZones.textContent = String(rows.filter((row) => row.zonalRegions.length > 0).length);
    }

    function applyQuickFilter(filterValue) {
      activeQuickFilter = filterValue;
      viewButtons.forEach((button) => {
        button.classList.toggle('is-active', button.dataset.viewFilter === filterValue);
      });

      if (filterValue === 'all') {
        vendorFilter.value = 'all';
        generationFilter.value = 'all';
        regionFilter.value = 'all';
        zoneFilter.value = 'all';
      } else if (filterValue === 'AMD' || filterValue === 'Intel') {
        vendorFilter.value = filterValue;
      } else if (filterValue === 'v6' || filterValue === 'v7') {
        generationFilter.value = filterValue;
      } else if (filterValue === 'zonal') {
        zoneFilter.value = 'three';
      }

      refresh();
    }

    function setRegionFilter(regionCode) {
      regionFilter.value = regionCode;
      applyQuickFilter('all');
    }

    function refresh() {
      const filtered = sortRows(vmSkus.filter(rowMatches));
      renderCards(filtered);
      renderRows(filtered);
      updateMetrics(filtered);
      filterStatus.textContent = `${filtered.length} SKU entries shown. Sweden Central remains the best coverage region in the master list.`;
    }

    [searchInput, vendorFilter, generationFilter, regionFilter, zoneFilter, sortFilter].forEach((node) => {
      node.addEventListener('input', refresh);
      node.addEventListener('change', refresh);
    });

    viewButtons.forEach((button) => {
      button.addEventListener('click', () => applyQuickFilter(button.dataset.viewFilter ?? 'all'));
    });

    regionCards.forEach((card) => {
      const regionCode = card.dataset.regionTarget;
      if (!regionCode) return;
      card.addEventListener('click', () => setRegionFilter(regionCode));
      card.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          setRegionFilter(regionCode);
        }
      });
    });

    refresh();
  </script>

  <style>
    .vm-lookup-shell {
      display: grid;
      gap: 1rem;
    }

    .hero-source {
      margin: 0.6rem 0 0;
      color: var(--muted);
      font-family: var(--font-display);
      font-size: 0.85rem;
    }

    .decision-strip {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .answer-card {
      display: grid;
      gap: 0.25rem;
      min-height: 100%;
    }

    .metric-subtext,
    .region-note,
    .raw-matrix-note {
      margin: 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .migration-warning,
    .reference-card,
    .lookup-panel,
    .metric-card {
      border: 1px solid var(--border);
      border-radius: 18px;
      background: color-mix(in srgb, var(--surface) 94%, transparent);
      box-shadow: var(--shadow);
      padding: 1rem;
    }

    .migration-warning h2,
    .reference-card h2 {
      font-size: clamp(1.15rem, 2vw, 1.5rem);
    }

    .migration-warning ul,
    .reference-card ul,
    .reference-card ol {
      margin: 0.75rem 0 0 1.1rem;
    }

    .migration-links {
      font-weight: 600;
    }

    .metrics {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }

    .region-card {
      cursor: pointer;
      transition: transform 160ms ease, border-color 160ms ease;
    }

    .region-card:hover,
    .region-card:focus-visible {
      transform: translateY(-2px);
      border-color: var(--accent);
      outline: none;
    }

    .metric-label {
      margin: 0;
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--muted);
      font-family: var(--font-display);
    }

    .metric-value {
      margin: 0.2rem 0 0;
      font-size: clamp(1.15rem, 2vw, 1.45rem);
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--text);
    }

    .browser-panel {
      border: 1px solid var(--border);
      border-radius: 18px;
      background: color-mix(in srgb, var(--surface) 94%, transparent);
      box-shadow: var(--shadow);
      padding: 1rem;
    }

    .browser-head {
      display: flex;
      justify-content: space-between;
      gap: 1rem;
      align-items: end;
      flex-wrap: wrap;
      margin-bottom: 0.8rem;
    }

    .browser-head p {
      color: var(--muted);
      margin-bottom: 0;
      max-width: 72ch;
    }

    .browser-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.45rem;
    }

    .action-chip {
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text);
      border-radius: 999px;
      padding: 0.4rem 0.75rem;
      font-family: var(--font-display);
      cursor: pointer;
    }

    .action-chip.is-active {
      border-color: var(--accent);
      color: var(--accent);
    }

    .filter-grid {
      display: grid;
      grid-template-columns: repeat(6, minmax(0, 1fr));
      gap: 0.65rem;
      margin-bottom: 0.75rem;
    }

    .filter-grid label {
      display: grid;
      gap: 0.3rem;
      font-family: var(--font-display);
      font-size: 0.84rem;
      color: var(--muted);
    }

    .filter-grid input,
    .filter-grid select {
      width: 100%;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text);
      border-radius: 10px;
      padding: 0.52rem 0.6rem;
      font-family: var(--font-body);
      font-size: 0.92rem;
    }

    .filter-status {
      margin: 0 0 0.75rem;
      color: var(--muted);
      font-family: var(--font-display);
      font-size: 0.84rem;
    }

    .sku-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0.75rem;
    }

    .sku-card {
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 0.85rem;
      background: color-mix(in srgb, var(--surface-2) 70%, transparent);
    }

    .sku-card-head {
      display: flex;
      justify-content: space-between;
      gap: 0.75rem;
      align-items: start;
    }

    .sku-card-kicker {
      margin: 0 0 0.25rem;
      color: var(--muted);
      font-size: 0.82rem;
      font-family: var(--font-display);
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .sku-card h3 {
      margin: 0;
      font-size: 1.03rem;
    }

    .sku-price {
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--accent);
      white-space: nowrap;
    }

    .sku-card-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.35rem;
      margin: 0.65rem 0;
      color: var(--muted);
      font-size: 0.85rem;
    }

    .sku-card-meta span {
      border: 1px solid var(--border);
      border-radius: 999px;
      padding: 0.15rem 0.5rem;
      background: color-mix(in srgb, var(--surface) 88%, transparent);
    }

    .region-chip-row {
      margin-top: 0.35rem;
    }

    .table-wrap {
      overflow-x: auto;
    }

    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.92rem;
    }

    th,
    td {
      border-bottom: 1px solid var(--border);
      text-align: left;
      padding: 0.58rem 0.52rem;
      vertical-align: top;
    }

    thead th {
      font-family: var(--font-display);
      font-size: 0.82rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--muted);
    }

    .matrix-col {
      min-width: 320px;
    }

    .region-pill {
      display: inline-flex;
      margin: 0 0.35rem 0.35rem 0;
      border-radius: 999px;
      border: 1px solid var(--border);
      padding: 0.14rem 0.45rem;
      font-size: 0.76rem;
      font-family: var(--font-display);
      background: color-mix(in srgb, var(--surface-2) 85%, transparent);
      color: var(--text);
    }

    .region-pill.is-off {
      opacity: 0.7;
    }

    .reference-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.9rem;
    }

    .raw-matrix {
      margin-top: 0.25rem;
    }

    .raw-matrix summary {
      cursor: pointer;
      font-family: var(--font-display);
      font-weight: 700;
    }

    @media (max-width: 1120px) {
      .decision-strip,
      .filter-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 900px) {
      .decision-strip,
      .metrics,
      .reference-grid {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 680px) {
      .browser-head {
        align-items: start;
      }

      .filter-grid {
        grid-template-columns: 1fr;
      }

      .sku-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
</BaseLayout>
