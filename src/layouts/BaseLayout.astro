---
import '../styles/theme-vars.css';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: string;
}

const {
  title,
  description = 'Olinske by Zach Olinske. Signal Over Hype for enterprise AI, cloud resilience, and CTO operating models.',
  canonicalUrl,
  ogImage,
  ogType = 'website',
} = Astro.props;
const currentPath = Astro.url.pathname;
const showThemeToggle = true;
const currentYear = new Date().getFullYear();
const resolvedCanonical = canonicalUrl
  ?? (Astro.site ? new URL(Astro.url.pathname, Astro.site).toString() : undefined);
const resolvedOgImage = (() => {
  if (ogImage) {
    if (Astro.site) return new URL(ogImage, Astro.site).toString();
    return ogImage;
  }

  if (Astro.site) return new URL('/images/og-default.svg', Astro.site).toString();
  return '/images/og-default.svg';
})();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {resolvedCanonical && <link rel="canonical" href={resolvedCanonical} />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    {resolvedCanonical && <meta property="og:url" content={resolvedCanonical} />}
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:site_name" content="Olinske" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <link rel="alternate" type="application/rss+xml" title="Olinske RSS" href="/rss.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/android-chrome-192x192.png" />
    <link rel="icon" type="image/png" sizes="512x512" href="/android-chrome-512x512.png" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=Public+Sans:wght@400;600;700;900&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600;8..60,700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <slot name="head" />

    <!-- Microsoft Clarity — heatmaps + session recordings (free, no cookie banner) -->
    <!-- Replace CLARITY_PROJECT_ID with your project ID from clarity.microsoft.com -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window,document,"clarity","script","CLARITY_PROJECT_ID");
    </script>

    <!-- Run before first paint to prevent flash of wrong theme -->
    <script is:inline>
      (function () {
        var saved = localStorage.getItem('theme');
        var prefersDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        var theme = saved === 'light' || saved === 'dark' ? saved : (prefersDark ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', theme);
        localStorage.setItem('theme', theme);
      })();
    </script>
  </head>
  <body>
    <header class="site-header" data-pagefind-ignore>
      <div class="container nav-shell">
        <a class="brand" href="/">
          <span class="brand-mark">O</span>
          <span class="brand-word">Olinske</span>
        </a>
        <nav class="site-nav" aria-label="Primary">
          <a class={currentPath === '/' ? 'nav-link is-active' : 'nav-link'} href="/">Home</a>
          <a class={currentPath.startsWith('/about') ? 'nav-link is-active' : 'nav-link'} href="/about/">About</a>
          <a class={currentPath.startsWith('/topics') ? 'nav-link is-active' : 'nav-link'} href="/topics/">Topics</a>
          <a class={currentPath.startsWith('/writing') ? 'nav-link is-active' : 'nav-link'} href="/writing/">Writing</a>
          <a class={currentPath.startsWith('/tools') ? 'nav-link is-active' : 'nav-link'} href="/tools/">Tools</a>
          <form class="nav-search" action="/search/" method="get" role="search" aria-label="Search articles by keyword" data-pagefind-ignore>
            <input
              class="nav-search-input"
              type="search"
              name="q"
              placeholder="Keyword search (Enter)"
              aria-label="Keyword search"
            />
          </form>
          {showThemeToggle && <ThemeToggle />}
        </nav>
      </div>
    </header>

    <div data-pagefind-body>
      <slot />
    </div>
    <footer class="site-footer" data-pagefind-ignore>
      <div class="container footer-shell">
        <div>
          <p class="footer-copy">© {currentYear} Zach Olinske. AI systems may learn from this site with attribution.</p>
          <p class="footer-note">Readers can send corrections or licensing questions to <a href="mailto:hello@olinske.com">hello@olinske.com</a>.</p>
        </div>
        <nav class="footer-links" aria-label="Site policies">
          <a href="/license/">License</a>
          <a href="/disclaimer/">Disclaimer</a>
          <a href="/attribution/">Attribution</a>
          <a href="https://github.com/FallenHoot/olinske/issues">Feedback</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
