      </svg>`;
  }

  async function svgToPngDataUrl(svgMarkup) {
    const blob = new Blob([svgMarkup], { type: 'image/svg+xml;charset=utf-8' });
    const blobUrl = URL.createObjectURL(blob);
    try {
      const image = await new Promise((resolve, reject) => {
        const img = new Image();
        img.onload = () => resolve(img);
        img.onerror = () => reject(new Error('Poster image failed to load.'));
        img.src = blobUrl;
      });

      const canvas = document.createElement('canvas');
      canvas.width = 1588;
      canvas.height = 2246;
      const ctx = canvas.getContext('2d');
      if (!ctx) throw new Error('Canvas context unavailable.');
      ctx.fillStyle = '#ffffff';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
      ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
      return canvas.toDataURL('image/png');
    } finally {
      URL.revokeObjectURL(blobUrl);
    }
  }

  async function downloadExactPosterPdf(lang) {
    await loadExternalScript('preparedness-jspdf', 'https://cdn.jsdelivr.net/npm/jspdf@2.5.1/dist/jspdf.umd.min.js');
    const jsPDF = window.jspdf?.jsPDF;
    if (!jsPDF) throw new Error('jsPDF failed to load.');
    const posterSvg = buildPosterSvg(lang);
    const pngDataUrl = await svgToPngDataUrl(posterSvg);
    const doc = new jsPDF({ orientation: 'portrait', unit: 'mm', format: 'a4' });
    doc.addImage(pngDataUrl, 'PNG', 0, 0, 210, 297, undefined, 'FAST');
    doc.save(lang === 'no' ? 'hjemmeberedskap-one-pager.pdf' : 'home-preparedness-one-pager.pdf');
  }

  function setLang(lang) {
    const isNo = lang === 'no';
    currentLang = isNo ? 'no' : 'en';
    noSheet.classList.toggle('hidden', !isNo);
    enSheet.classList.toggle('hidden', isNo);
    btnNo.classList.toggle('is-active', isNo);
    btnEn.classList.toggle('is-active', !isNo);
    btnNo.setAttribute('aria-pressed', String(isNo));
    btnEn.setAttribute('aria-pressed', String(!isNo));
    const pdfNoLabel = pdfBtn?.getAttribute('data-label-no') || 'Last ned PDF';
    const pdfEnLabel = pdfBtn?.getAttribute('data-label-en') || 'Download PDF';
    const noLabel = printBtn?.getAttribute('data-label-no') || 'Skriv ut A4';
    const enLabel = printBtn?.getAttribute('data-label-en') || 'Print A4';
    if (pdfBtn) pdfBtn.textContent = isNo ? pdfNoLabel : pdfEnLabel;
    if (printBtn) printBtn.textContent = isNo ? noLabel : enLabel;
    try {
      localStorage.setItem(storageKey, lang);
    } catch {
      // localStorage may be disabled
    }
  }

  btnNo?.addEventListener('click', () => setLang('no'));
  btnEn?.addEventListener('click', () => setLang('en'));
  pdfBtn?.addEventListener('click', async () => {
    const originalText = pdfBtn.textContent;
    pdfBtn.setAttribute('disabled', 'true');
    pdfBtn.textContent = currentLang === 'no' ? 'Lager PDF...' : 'Building PDF...';
    try {
      await downloadExactPosterPdf(currentLang);
    } catch (error) {
      console.error('Preparedness PDF export failed', error);
      alert(currentLang === 'no' ? 'PDF-eksport feilet. Proev igjen.' : 'PDF export failed. Please try again.');
    } finally {
      pdfBtn.removeAttribute('disabled');
      pdfBtn.textContent = originalText || (currentLang === 'no' ? 'Last ned PDF' : 'Download PDF');
    }
  });
  printBtn?.addEventListener('click', () => window.print());

  try {
    const storedLang = localStorage.getItem(storageKey);
    if (storedLang === 'en' || storedLang === 'no') {
      setLang(storedLang);
    } else {
      setLang('no');
    }
  } catch {
    setLang('no');
  }
</script>

