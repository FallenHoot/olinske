  function loadExternalScript(id, src) {
    if (document.getElementById(id)) return Promise.resolve();
    return new Promise((resolve, reject) => {
      const script = document.createElement('script');
      script.id = id;
      script.src = src;
      script.async = true;
      script.onload = () => resolve();
      script.onerror = () => reject(new Error(`Failed to load ${src}`));
      document.head.appendChild(script);
    });
  }

  function escapeXml(value) {
    return String(value)
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&apos;');
  }

  function checklistSvg(items, x, y, lineHeight, fontSize) {
    return items.map((item, index) => {
      const top = y + index * lineHeight;
      return `
        <rect x="${x}" y="${top - 12}" width="14" height="14" fill="#fff" stroke="#111827" stroke-width="2"/>
        <text x="${x + 22}" y="${top}" font-family="Arial, sans-serif" font-size="${fontSize}" font-weight="700" fill="#111">${escapeXml(item)}</text>`;
    }).join('');
  }

  function lineBlockSvg(lines, x, y, width, lineHeight, fontSize) {
    return lines.map((line, index) => {
      const top = y + index * lineHeight;
      return `
        <text x="${x}" y="${top}" font-family="Arial, sans-serif" font-size="${fontSize}" font-weight="600" fill="#111">${escapeXml(line)}</text>
        <line x1="${x}" y1="${top + 5}" x2="${x + width}" y2="${top + 5}" stroke="#333" stroke-width="1"/>`;
    }).join('');
  }

  function inlineIcon(id, x, y, width, height) {
    const icons = {
