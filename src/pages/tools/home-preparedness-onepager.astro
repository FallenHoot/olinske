      flame: `<g transform="translate(${x} ${y}) scale(${width / 128} ${height / 128})"><path fill="#b33a34" d="M84 118c20-10 31-29 31-48 0-13-6-24-18-37 0 13-7 20-16 27-3-13-12-22-25-31 2 12 0 20-8 30-8 10-17 19-17 34 0 21 14 35 53 35z"/></g>`,
    };

    return icons[id] || '';
  }

  function buildPosterSvg(lang) {
    const c = posterContent[lang] ?? posterContent.no;
    return `
      <svg xmlns="http://www.w3.org/2000/svg" width="794" height="1123" viewBox="0 0 794 1123">
        <rect width="794" height="1123" fill="#ffffff"/>
        <text x="397" y="72" text-anchor="middle" font-family="Arial, sans-serif" font-size="34" font-weight="900" fill="#111">${escapeXml(c.title)}</text>
        <text x="397" y="118" text-anchor="middle" font-family="Arial, sans-serif" font-size="26" font-weight="700" fill="#111">${escapeXml(c.subtitle)}</text>

        ${inlineIcon('alert', 42, 142, 92, 92)}
        <text x="164" y="168" font-family="Arial, sans-serif" font-size="22" font-weight="900" fill="#a23a2f">${escapeXml(c.evacTitle)}</text>
        ${checklistSvg(c.evacItems, 164, 194, 27, 14)}
        <text x="164" y="310" font-family="Arial, sans-serif" font-size="13" font-style="italic" font-weight="600" fill="#222">${escapeXml(c.evacNote)}</text>

        <rect x="485" y="150" width="262" height="102" fill="#fff" stroke="#111" stroke-width="2"/>
        <text x="497" y="176" font-family="Arial, sans-serif" font-size="14" font-weight="900" fill="#111">${escapeXml(c.localTitle)}</text>
        ${lineBlockSvg(c.localLines, 497, 198, 220, 19, 11)}

        ${inlineIcon('fire', 44, 258, 92, 92)}
        <text x="164" y="284" font-family="Arial, sans-serif" font-size="28" font-weight="900" fill="#111">${escapeXml(c.fireTitle)}</text>
        <line x1="164" y1="290" x2="652" y2="290" stroke="#888" stroke-width="1"/>
        ${checklistSvg(c.fireLeft, 164, 318, 30, 16)}
        ${checklistSvg(c.fireRight, 426, 318, 30, 16)}

        ${inlineIcon('timer', 44, 372, 92, 92)}
        <text x="164" y="398" font-family="Arial, sans-serif" font-size="28" font-weight="900" fill="#111">${escapeXml(c.prepTitle)}</text>
        <line x1="164" y1="404" x2="652" y2="404" stroke="#888" stroke-width="1"/>
        ${checklistSvg(c.prepLeft, 164, 432, 31, 16)}
        ${checklistSvg(c.prepRight, 426, 432, 31, 16)}

        ${inlineIcon('radio', 46, 500, 90, 90)}
        <text x="164" y="528" font-family="Arial, sans-serif" font-size="28" font-weight="900" fill="#111">${escapeXml(c.powerTitle)}</text>
        <line x1="164" y1="534" x2="652" y2="534" stroke="#888" stroke-width="1"/>
        ${checklistSvg(c.powerLeft, 164, 562, 31, 16)}
        ${checklistSvg(c.powerRight, 426, 562, 31, 16)}

        ${inlineIcon('folder', 44, 644, 92, 72)}
        <text x="164" y="672" font-family="Arial, sans-serif" font-size="28" font-weight="900" fill="#111">${escapeXml(c.docsTitle)}</text>
        <line x1="164" y1="678" x2="652" y2="678" stroke="#888" stroke-width="1"/>
        ${checklistSvg(c.docsLeft, 164, 706, 31, 16)}
        ${checklistSvg(c.docsRight, 525, 706, 31, 16)}

        ${inlineIcon('gear', 44, 790, 86, 86)}
