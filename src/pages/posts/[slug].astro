---
import BaseLayout from '../../layouts/BaseLayout.astro';
import VoteButtons from '../../components/VoteButtons.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => data.status === 'published' || data.status === 'scheduled');
  return posts.map((post) => ({
    params: { slug: post.data.slug ?? post.id.replace(/\.md$/, '') },
    props: { post }
  }));
}

const { post } = Astro.props;
const allPublishedPosts = await getCollection('posts', ({ data }) => data.status === 'published' || data.status === 'scheduled');
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const slug = post.data.slug ?? post.id.replace(/\.md$/, '');
const canonicalUrl = Astro.site ? new URL(`/posts/${slug}/`, Astro.site).toString() : `/posts/${slug}/`;
const ogImage = `/og/${slug}.svg`;
const publishedIso = post.data.publishDate.toISOString();
const modifiedIso = (post.data.lastUpdated ?? post.data.publishDate).toISOString();
const lastReviewed = (post.data.lastUpdated ?? post.data.publishDate).toISOString().slice(0, 10);

const postBySlug = new Map(
  allPublishedPosts.map((item) => [item.data.slug ?? item.id.replace(/\.md$/, ''), item])
);

const prerequisiteLinks = (post.data.prerequisites ?? [])
  .map((entry) => {
    const ref = entry.replace(/^\/posts\//, '').replace(/\/$/, '');
    const related = postBySlug.get(ref);
    return related
      ? {
          href: `/posts/${ref}/`,
          title: related.data.title,
        }
      : {
          href: `/posts/${ref}/`,
          title: ref,
        };
  });

const followUpLinks = (post.data.followUps ?? [])
  .map((entry) => {
    const ref = entry.replace(/^\/posts\//, '').replace(/\/$/, '');
    const related = postBySlug.get(ref);
    return related
      ? {
          href: `/posts/${ref}/`,
          title: related.data.title,
        }
      : {
          href: `/posts/${ref}/`,
          title: ref,
        };
  });

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  author: {
    '@type': 'Person',
    name: 'Zach Olinske'
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl
  }
};

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: Astro.site ? new URL('/', Astro.site).toString() : '/'
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Articles',
      item: Astro.site ? new URL('/posts/', Astro.site).toString() : '/posts/'
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: post.data.title,
      item: canonicalUrl
    }
  ]
};
---

<BaseLayout title={`${post.data.title} | Olinske`} description={post.data.description} canonicalUrl={canonicalUrl} ogImage={ogImage} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={publishedIso} />
    <meta property="article:modified_time" content={modifiedIso} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  </Fragment>

  <main class="container site-shell">
    <section class="hero-panel fade-in">
      <p class="eyebrow">{post.data.publishDate.toISOString().slice(0, 10)}</p>
      <h1 class="hero-title">{post.data.title}</h1>
      <p class="hero-subtitle">{post.data.description}</p>
      <p class="post-meta">Last reviewed: {lastReviewed}</p>
      {post.data.appliesTo && <p class="post-meta">Applies to: {post.data.appliesTo}</p>}
      <div class="tag-row">
        {(post.data.tags ?? []).map((tag) => (
          <span class="tag-chip">{tag}</span>
        ))}
      </div>
    </section>

    {
      post.data.bluf && post.data.bluf.length > 0 && (
        <section class="hero-panel fade-in fade-delay-1">
          <p class="eyebrow">TL;DR</p>
          <ul class="toc-list">
            {post.data.bluf.map((item) => <li class="toc-item">{item}</li>)}
          </ul>
        </section>
      )
    }

    <section class="article-shell fade-in fade-delay-2">
      {
        (prerequisiteLinks.length > 0 || followUpLinks.length > 0) && (
          <aside class="toc-panel">
            {prerequisiteLinks.length > 0 && (
              <>
                <h2>This post assumes knowledge from</h2>
                <ul class="toc-list">
                  {prerequisiteLinks.map((item) => (
                    <li class="toc-item"><a href={item.href}>{item.title}</a></li>
                  ))}
                </ul>
              </>
            )}

            {followUpLinks.length > 0 && (
              <>
                <h2 style="margin-top:0.9rem;">Follow-up deep dives</h2>
                <ul class="toc-list">
                  {followUpLinks.map((item) => (
                    <li class="toc-item"><a href={item.href}>{item.title}</a></li>
                  ))}
                </ul>
              </>
            )}
          </aside>
        )
      }

      <aside class="toc-panel">
        <h2>On this page</h2>
        {
          toc.length === 0 ? (
            <p class="post-meta">No sections found.</p>
          ) : (
            <ul class="toc-list" id="toc-list">
              {toc.map((heading) => (
                <li class={heading.depth === 3 ? 'toc-item toc-sub' : 'toc-item'}>
                  <a href={`#${heading.slug}`}>{heading.text}</a>
                </li>
              ))}
            </ul>
          )
        }
      </aside>

      <article class="article-panel">
        <Content />
      </article>

      <VoteButtons slug={slug} />
    </section>
  </main>

  <script>
    import mermaid from 'mermaid';

    const mermaidCodeBlocks = Array.from(document.querySelectorAll('.article-panel pre > code.language-mermaid'));
    if (mermaidCodeBlocks.length > 0) {
      mermaid.initialize({
        startOnLoad: false,
        securityLevel: 'strict',
        theme: 'neutral',
      });

      mermaidCodeBlocks.forEach((codeBlock) => {
        const source = codeBlock.textContent?.trim();
        if (!source) return;

        const container = document.createElement('div');
        container.className = 'mermaid';
        container.textContent = source;

        const pre = codeBlock.parentElement;
        if (pre) pre.replaceWith(container);
      });

      const mermaidNodes = Array.from(document.querySelectorAll('.article-panel .mermaid'));
      if (mermaidNodes.length > 0) {
        mermaid.run({ nodes: mermaidNodes }).catch((error) => {
          console.error('Mermaid render failed', error);
        });
      }
    }

    const headingNodes = Array.from(document.querySelectorAll('.article-panel h2[id], .article-panel h3[id]'));
    const tocAnchors = Array.from(document.querySelectorAll('.toc-list a'));
    const anchorMap = new Map(tocAnchors.map((anchor) => [anchor.getAttribute('href')?.slice(1), anchor]));

    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
        if (!visible.length) return;

        const activeId = visible[0].target.getAttribute('id');
        tocAnchors.forEach((anchor) => anchor.classList.remove('is-active'));
        const activeAnchor = activeId ? anchorMap.get(activeId) : null;
        if (activeAnchor) activeAnchor.classList.add('is-active');
      },
      { rootMargin: '-35% 0px -55% 0px', threshold: [0, 1] }
    );

    headingNodes.forEach((heading) => observer.observe(heading));
  </script>
</BaseLayout>
