    function createEmptyRow(index) {
      const row = {};
      for (const column of columns) row[column.key] = column.key === 'circuit' ? String(index + 1) : '';
      return row;
    }

    function createInitialState() {
      return {
        mode: 'basic',
        descriptionFlow: 'continue-row',
        meta: Object.fromEntries(metaFields.map((field) => [field.key, ''])),
        rows: Array.from({ length: ROW_COUNT }, (_, index) => createEmptyRow(index)),
      };
    }

    function normalizeState(raw) {
      const fallback = createInitialState();
      if (!raw || typeof raw !== 'object') return fallback;
      const meta = Object.fromEntries(metaFields.map((field) => [field.key, typeof raw.meta?.[field.key] === 'string' ? raw.meta[field.key] : '']));
      const rows = Array.isArray(raw.rows) && raw.rows.length
        ? raw.rows.map((row, index) => ({ ...createEmptyRow(index), ...row, circuit: String(index + 1) }))
        : fallback.rows;
      const descriptionFlow = ['continue-row', 'wrap', 'truncate'].includes(raw.descriptionFlow) ? raw.descriptionFlow : 'continue-row';
      return { mode: raw.mode === 'advanced' ? 'advanced' : 'basic', descriptionFlow, meta, rows };
    }

    function loadState() {
      try {
        const raw = window.localStorage.getItem(STORAGE_KEY);
        return raw ? normalizeState(JSON.parse(raw)) : createInitialState();
      } catch {
        return createInitialState();
      }
    }

    let state = loadState();
    const metaGrid = document.querySelector('#meta-grid');
    const tableHead = document.querySelector('#table-head');
    const tableBody = document.querySelector('#table-body');
    const validationList = document.querySelector('#validation-list');
    const validationSummary = document.querySelector('#validation-summary');
    const rowSummary = document.querySelector('#row-summary');
    const sheetFrame = document.querySelector('#sheet-frame');
    const exampleSelect = document.querySelector('#example-select');
    const saveStatus = document.querySelector('#save-status');
    const sheetMode = document.querySelector('#sheet-mode');
    const descriptionFlow = document.querySelector('#description-flow');
    let selectedExampleValue = '';

    function isAdvancedMode() {
      return state.mode === 'advanced';
    }

    function escapeHtml(value) {
      return String(value ?? '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');
    }

    function saveState(message = 'Saved locally.') {
      window.localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
      saveStatus.textContent = message;
    }

    function numericValue(value) {
      const normalized = String(value ?? '').replace(',', '.').trim();
      if (!normalized) return null;
      const parsed = Number(normalized);
      return Number.isFinite(parsed) ? parsed : null;
    }

    function isVague(text) {
      return ['light', 'lights', 'plug', 'plugs', 'misc', 'outlet', 'outlets'].includes(String(text ?? '').trim().toLowerCase());
    }

    function applyPreset(row, value) {
      const preset = presetOptions.find((item) => item.value === value);
      if (!preset) return;
      row.preset = value;
      for (const [key, presetValue] of Object.entries(preset)) {
        if (key === 'value' || key === 'label') continue;
        row[key] = presetValue;
      }
    }

    function displayDescription(row) {
      const description = String(row?.description ?? '').trim();
      if (description) return description;
      return String(row?.status ?? '').toLowerCase() === 'spare' ? 'SPARE' : '';
    }

    function validateRows() {
      const findings = [];
      state.rows.forEach((row, index) => {
        const rowNo = row.circuit || String(index + 1);
        const description = String(row.description ?? '').trim();
        const hasContent = columns.some((column) => !column.editorOnly && column.key !== 'circuit' && String(row[column.key] ?? '').trim() !== '');
        if (!hasContent) return;

        if (!description) findings.push({ severity: 'error', message: `Circuit ${rowNo}: description is required.` });
        else if (isVague(description)) findings.push({ severity: 'error', message: `Circuit ${rowNo}: description is too vague.` });
        if (String(row.status ?? '').toLowerCase() === 'spare' && description !== 'SPARE') findings.push({ severity: 'warn', message: `Circuit ${rowNo}: spare breakers should be labeled SPARE.` });

        const ib = numericValue(row.ib);
        const inValue = numericValue(row.ratingA);
        const iz = numericValue(row.iz);
        const cable = numericValue(row.cable);
        const context = `${description} ${row.remarks ?? ''}`.toLowerCase();

        if (ib !== null && inValue !== null && iz !== null && !(ib <= inValue && inValue <= iz)) findings.push({ severity: 'error', message: `Circuit ${rowNo}: I_b <= I_n <= I_z failed.` });
        if (cable !== null && cable <= 1.5 && inValue !== null && inValue > 13) findings.push({ severity: 'error', message: `Circuit ${rowNo}: 1.5 mm2 above 13A needs redesign or justification.` });
        if (cable !== null && cable === 2.5 && inValue !== null && inValue > 16) findings.push({ severity: 'warn', message: `Circuit ${rowNo}: 2.5 mm2 above 16A needs thermal review.` });
        if ((context.includes('pump') || context.includes('compressor') || context.includes('motor') || context.includes('refrigerator')) && String(row.curve ?? '').toUpperCase() === 'B') findings.push({ severity: 'warn', message: `Circuit ${rowNo}: consider C curve review for inrush loads.` });
      });
      return findings.length ? findings : [{ severity: 'ok', message: 'No active findings.' }];
    }

    function renderMeta() {
      const visibleFields = metaFields.filter((field) => !field.advanced || isAdvancedMode());
      metaGrid.innerHTML = visibleFields.map((field) => `
        <label class="meta-field">
          <span>${field.label}</span>
          <input type="text" data-meta-key="${field.key}" value="${escapeHtml(state.meta[field.key] ?? '')}" placeholder="${escapeHtml(field.placeholder)}" />
        </label>
      `).join('');
    }

    function renderCell(row, rowIndex, column) {
      const value = row[column.key] ?? '';
      if (column.type === 'select') {
        return `<select data-row-index="${rowIndex}" data-column-key="${column.key}" style="width:${column.width}; min-width:${column.width};">${column.options.map((option) => `<option value="${escapeHtml(option.value)}" ${String(option.value) === String(value) ? 'selected' : ''}>${escapeHtml(option.label)}</option>`).join('')}</select>`;
      }
      return `<input type="text" data-row-index="${rowIndex}" data-column-key="${column.key}" value="${escapeHtml(value)}" style="width:${column.width}; min-width:${column.width};" ${column.readonly ? 'readonly' : ''} />`;
    }

    function renderTable() {
      tableHead.innerHTML = columns.map((column) => `<th>${column.label}</th>`).join('') + '<th>Rad</th>';
      tableBody.innerHTML = state.rows.map((row, rowIndex) => `
        <tr>
          ${columns.map((column) => `<td>${renderCell(row, rowIndex, column)}</td>`).join('')}
          <td class="row-actions-cell">
            <button type="button" class="row-insert-btn" data-insert-row-index="${rowIndex}" title="Insert blank row below">Insert</button>
            <button type="button" class="row-delete-btn" data-delete-row-index="${rowIndex}" title="Delete this row">Delete</button>
          </td>
        </tr>
      `).join('');
    }

    function renderExamples() {
      exampleSelect.innerHTML = '<option value="">Choose example</option>' + examples.map((example) => `<option value="${example.value}">${example.label}</option>`).join('');
      exampleSelect.value = examples.some((example) => example.value === selectedExampleValue) ? selectedExampleValue : '';
      if (sheetMode) sheetMode.value = state.mode;
      if (descriptionFlow) descriptionFlow.value = state.descriptionFlow || 'continue-row';
    }

    function renderValidation() {
      const findings = validateRows();
      validationList.innerHTML = findings.map((item) => `<li class="${item.severity}">${escapeHtml(item.message)}</li>`).join('');
      validationSummary.textContent = findings[0]?.severity === 'ok' ? 'No active findings.' : `${findings.length} active finding${findings.length === 1 ? '' : 's'}.`;
    }

    function renderRowSummary() {
      if (!rowSummary) return;
      rowSummary.textContent = `Rows: ${state.rows.length}`;
    }

    function renderPreview() {
      const previewColumns = columns.filter((column) => !column.editorOnly);
      const findings = validateRows();
      const rowsUsed = state.rows.filter((row) => String(row.description ?? '').trim() !== '').length;
      const installerMarkup = [
        ['Elektroinstallator', state.meta.installer],
        ['Telefon', state.meta.installerPhone],
        ['Prosjekt', state.meta.projectName],
        ['Ordre', state.meta.workOrder],
      ].map(([label, value]) => `<div class="paper-field-row"><span class="paper-field-label">${label}</span><span class="paper-field-value">${escapeHtml(value || '\u00A0')}</span></div>`).join('');

      const installationMarkup = [
        ['Fordeling', state.meta.boardName],
        ['Anleggsadresse', state.meta.projectAddress],
        ['Lokasjon', state.meta.location],
        ['Forsyning', state.meta.supply],
      ].map(([label, value]) => `<div class="paper-field-row"><span class="paper-field-label">${label}</span><span class="paper-field-value">${escapeHtml(value || '\u00A0')}</span></div>`).join('');

      const customerMarkup = [
        ['Kunde', state.meta.customer],
        ['Kundenummer', state.meta.customerNumber],
      ].map(([label, value]) => `<div class="paper-field-row"><span class="paper-field-label">${label}</span><span class="paper-field-value">${escapeHtml(value || '\u00A0')}</span></div>`).join('');

      const noteMarkup = [
        ['Viktig', 'Eier eller bruker er ansvarlig for at den elektriske installasjonen og det elektriske utstyret er i henhold til gjeldende regelverk.'],
      ].map(([label, value]) => `<div class="paper-field-row note-row"><span class="paper-field-label">${label}</span><span class="paper-field-value">${escapeHtml(value)}</span></div>`).join('');

      const advancedAddressMarkup = [
        ['Firmanavn', state.meta.anleggsFirma],
        ['Adresse', state.meta.anleggsAdresse],
        ['Hus nr', state.meta.husNr],
        ['Bokstav', state.meta.bokstav],
        ['SSB-nummer', state.meta.ssbNummer],
      ].map(([label, value]) => `<div class="paper-field-row"><span class="paper-field-label">${label}</span><span class="paper-field-value">${escapeHtml(value || '\u00A0')}</span></div>`).join('');

      const advancedShortCircuitMarkup = [
        ['Ik maks', state.meta.ikMax],
        ['Ik min', state.meta.ikMin],
        ['Ij min', state.meta.ijMin],
        ['Kilde', state.meta.kortslutningKilde],
      ].map(([label, value]) => `<div class="paper-field-row"><span class="paper-field-label">${label}</span><span class="paper-field-value">${escapeHtml(value || '\u00A0')}</span></div>`).join('');

      const advancedSystemMarkup = [
        ['Systemspenning', state.meta.systemspenning],
        ['Fordelingssystem', state.meta.fordelingssystem],
        ['Type jordelektrode', state.meta.jordelektrode],
        ['Tilforsel', state.meta.tilforsel],
        ['Maler nr.', state.meta.malerNr],
      ].map(([label, value]) => `<div class="paper-field-row"><span class="paper-field-label">${label}</span><span class="paper-field-value">${escapeHtml(value || '\u00A0')}</span></div>`).join('');

      const headMarkup = previewColumns.map((column) => `<th>${column.label}</th>`).join('');
      const rowMarkup = state.rows.map((row) => `<tr>${previewColumns.map((column) => {
        if (column.key === 'description') return `<td>${escapeHtml(displayDescription(row) || '\u00A0')}</td>`;
        if (column.key === 'status' && !row.status) return '<td>Active</td>';
        return `<td>${escapeHtml(row[column.key] || '\u00A0')}</td>`;
      }).join('')}</tr>`).join('');

      const findingMarkup = findings[0]?.severity === 'ok'
        ? '<li class="ok">Ingen aktive merknader.</li>'
        : findings.slice(0, 4).map((item) => `<li class="${item.severity}">${escapeHtml(item.message)}</li>`).join('');

      const advancedBlocks = isAdvancedMode() ? `
          <section class="paper-form-grid advanced-grid">
            <article class="paper-block wide-block">
              <h4>Anleggsadresse</h4>
              ${advancedAddressMarkup}
            </article>
            <article class="paper-block">
              <h4>Kortslutningsverdier</h4>
              ${advancedShortCircuitMarkup}
            </article>
            <article class="paper-block">
              <h4>Anleggsdata</h4>
              ${advancedSystemMarkup}
            </article>
          </section>
      ` : '';

      sheetFrame.innerHTML = `
        <div class="paper-sheet nek-sheet">
          <header class="paper-title-row">
            <div>
              <p class="paper-title-kicker">NEK 400 / FEL</p>
              <h3>Kursfortegnelse</h3>
            </div>
            <div class="paper-title-side">
              <div class="paper-warning-block">
                <span class="paper-warning-title">ADVARSEL</span>
                <p>Eier og bruker skal sorge for drift og vedlikehold slik at anlegget til enhver tid oppfyller gjeldende forskrifter.</p>
              </div>
              <div class="paper-mini-block">
                <span>Utfylte kurser</span>
                <strong>${rowsUsed}</strong>
              </div>
            </div>
          </header>

          <section class="paper-form-grid top-grid">
            <article class="paper-block">
              <h4>Elektroinstallator</h4>
              ${installerMarkup}
            </article>
            <article class="paper-block">
              <h4>Installasjon</h4>
              ${installationMarkup}
            </article>
          </section>

          <section class="paper-form-grid secondary-grid">
            <article class="paper-block wide-block">
              <h4>Kunde</h4>
              ${customerMarkup}
            </article>
            <article class="paper-block note-block">
              ${noteMarkup}
            </article>
          </section>

          ${advancedBlocks}

          <section class="table-scroll paper-table-shell">
            <table class="sheet-table nek-table">
              <thead><tr>${headMarkup}</tr></thead>
              <tbody>${rowMarkup}</tbody>
            </table>
          </section>

          <section class="paper-findings paper-block">
            <h4>Kontroll og merknader</h4>
            <ul>${findingMarkup}</ul>
          </section>
        </div>
      `;
    }

    function renderAll() {
      renderMeta();
      renderExamples();
      renderTable();
      renderValidation();
      renderRowSummary();
      renderPreview();
    }

    function buildOfficialSheetHtml() {
      const maxRows = Math.max(24, state.rows.length);
      const truncateDescription = (text, maxChars = 64) => {
        const value = String(text ?? '').trim();
        if (value.length <= maxChars) return value;
        return `${value.slice(0, maxChars - 1).trimEnd()}…`;
      };

      const rows = Array.from({ length: maxRows }, (_, index) => {
        const row = state.rows[index] ?? createEmptyRow(index);
        return {
          no: String(index + 1),
          description: truncateDescription(displayDescription(row) || ''),
          amp: String(row.ratingA ?? '').trim(),
          curve: String(row.curve ?? '').trim(),
          length: String(row.length ?? '').trim(),
          mm2: String(row.cable ?? '').trim(),
          mate: String(row.method ?? '').replace(/^Method\s*/i, '').trim(),
        };
      });

      const rowMarkup = rows.map((row) => `
        <tr>
          <td class="c-no">${escapeHtml(row.no)}</td>
          <td class="c-desc">${escapeHtml(row.description || '\u00A0')}</td>
          <td class="c-amp">${escapeHtml(row.amp || '\u00A0')}</td>
          <td class="c-kar">${escapeHtml(row.curve || '\u00A0')}</td>
          <td class="c-len">${escapeHtml(row.length || '\u00A0')}</td>
          <td class="c-mm2">${escapeHtml(row.mm2 || '\u00A0')}</td>
          <td class="c-mate">${escapeHtml(row.mate || '\u00A0')}</td>
        </tr>
      `).join('');

      return `<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <title>NEK 400 Kursfortegnelse</title>
    <style>
      @page { size: A4 portrait; margin: 5mm; }
      html, body { margin: 0; padding: 0; background: #fff; color: #000; font-family: Arial, Helvetica, sans-serif; }
      .sheet {
        width: 190mm;
        min-height: 287mm;
        margin: 0 auto;
        border: 1px solid #000;
        box-sizing: border-box;
        padding: 1.5mm;
        display: flex;
        flex-direction: column;
      }
      table { width: 100%; border-collapse: collapse; table-layout: fixed; }
      td, th { border: 1px solid #000; font-size: 9px; line-height: 1.05; padding: 0.5px 1.5px; vertical-align: middle; }
      .head td { height: 8mm; }
      .head-label { font-size: 9px; font-weight: 700; }
      .head-value { display: block; margin-top: 1px; font-size: 9px; font-weight: 400; min-height: 7px; }
      .warn {
        font-size: 8px;
        line-height: 1.1;
      }
      .warn strong {
        display: block;
        font-size: 19px;
        letter-spacing: 0.2em;
        text-align: center;
        margin-bottom: 1px;
      }
      .subhead th { font-size: 10px; text-align: left; height: 6mm; }
      .grouphead th { font-size: 9px; text-align: center; height: 4.2mm; }
      .cols th { font-size: 8px; text-align: center; height: 4.2mm; }
      .rows td { height: 5mm; }
      .c-no, .c-amp, .c-kar, .c-len, .c-mm2, .c-mate { text-align: center; }
      .c-no { width: 8%; }
      .c-desc { width: 56%; }
      .c-amp { width: 7%; }
      .c-kar { width: 7%; }
      .c-len { width: 8%; }
      .c-mm2 { width: 7%; }
      .c-mate { width: 7%; }
      .bottom-strip {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 2mm;
        align-items: stretch;
        flex: 1 1 auto;
        margin-top: auto;
        padding-top: 1.5mm;
      }
      .note-box {
        border: 1px solid #000;
        min-height: 55mm;
        height: 100%;
        padding: 1.4mm;
        box-sizing: border-box;
        display: flex;
        flex-direction: column;
        justify-content: flex-start;
      }
      .note-box .label {
        display: block;
        font-size: 9px;
        font-weight: 700;
        margin-bottom: 0;
      }
      .business-card {
        width: 85mm;
        height: 55mm;
        border: 1px dashed #000;
        box-sizing: border-box;
        display: flex;
        align-items: center;
        justify-content: center;
        align-self: end;
        text-align: center;
        font-size: 8px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
      }
    </style>
  </head>
  <body>
    <div class="sheet">
      <table>
        <tr class="head">
          <td style="width:40%;">
            <span class="head-label">Installatør:</span>
            <span class="head-value">${escapeHtml(state.meta.installer || '\u00A0')}</span>
          </td>
          <td style="width:32%;">
            <span class="head-label">Anlegg nr.:</span>
            <span class="head-value">${escapeHtml(state.meta.boardName || '\u00A0')}</span>
            <span class="head-label" style="margin-top:3px;display:block;">Tilkobl. fase:</span>
            <span class="head-value">${escapeHtml(state.meta.supply || '\u00A0')}</span>
          </td>
          <td rowspan="2" style="width:28%;" class="warn">
            <strong>ADVARSEL!</strong>
            Abonnenten er etter sterkstrømforskriftene forpliktet til å melde installasjonsendringer.
            Elektrisitetsverket har påtalt at anseelse forholdene vedkommende.
          </td>
        </tr>
        <tr class="head">
          <td>
            <span class="head-label">Tlf.:</span>
            <span class="head-value">${escapeHtml(state.meta.installerPhone || '\u00A0')}</span>
          </td>
          <td>
            <span class="head-label">Adresse:</span>
            <span class="head-value">${escapeHtml(state.meta.projectAddress || '\u00A0')}</span>
          </td>
        </tr>
      </table>

      <table>
        <tr class="grouphead">
          <th class="c-no">KURS</th>
          <th class="c-desc"></th>
          <th colspan="2">SIKRING</th>
          <th colspan="3">LEDNING</th>
        </tr>
        <tr class="cols">
          <th class="c-no">NR.</th>
          <th class="c-desc" style="text-align:left;">KURSFORTEGNELSE:</th>
          <th class="c-amp">Amp.</th>
          <th class="c-kar">Kar.</th>
          <th class="c-len">Lengde</th>
          <th class="c-mm2">mm²</th>
          <th class="c-mate">MÅTE</th>
        </tr>
        <tbody class="rows">
          ${rowMarkup}
        </tbody>
      </table>

      <div class="bottom-strip">
        <div class="note-box">
          <span class="label">Merknad:</span>
        </div>
        <div class="business-card">Plass for installator-sticker/signatur 85 x 55 mm</div>
      </div>
    </div>
  </body>
</html>`;
    }

    function loadExample(value) {
      const example = examples.find((item) => item.value === value);
      if (!example) return;
      const selectedMode = sheetMode && sheetMode.value === 'advanced'
        ? 'advanced'
        : (sheetMode && sheetMode.value === 'basic' ? 'basic' : state.mode);
      selectedExampleValue = example.value;
      state = {
        mode: selectedMode === 'advanced' ? 'advanced' : 'basic',
        descriptionFlow: state.descriptionFlow || 'continue-row',
        meta: { ...Object.fromEntries(metaFields.map((field) => [field.key, ''])), ...example.meta },
        rows: Array.from({ length: ROW_COUNT }, (_, index) => ({ ...createEmptyRow(index), ...(example.rows[index] ?? {}), circuit: String(index + 1) })),
      };
      renderAll();
      saveState(`Loaded example: ${example.label}.`);
    }

    metaGrid.addEventListener('input', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLInputElement)) return;
      state.meta[target.dataset.metaKey] = target.value;
      renderPreview();
      saveState();
    });

    sheetMode?.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      state.mode = target.value === 'advanced' ? 'advanced' : 'basic';
      renderAll();
      saveState(`Switched to ${state.mode === 'advanced' ? 'advanced' : 'basic'} mode.`);
    });

    descriptionFlow?.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      state.descriptionFlow = ['continue-row', 'wrap', 'truncate'].includes(target.value) ? target.value : 'continue-row';
      renderAll();
      saveState(`Long text mode: ${state.descriptionFlow}.`);
    });

    function handleRowUpdate(event) {
      const target = event.target;
      if (!(target instanceof HTMLInputElement) && !(target instanceof HTMLSelectElement)) return;
      const rowIndex = Number(target.dataset.rowIndex);
      const columnKey = target.dataset.columnKey;
      if (Number.isNaN(rowIndex) || !columnKey || !state.rows[rowIndex]) return;
      state.rows[rowIndex][columnKey] = target.value;
      if (columnKey === 'preset') applyPreset(state.rows[rowIndex], target.value);
      if (columnKey === 'status' && String(target.value).toLowerCase() === 'spare') state.rows[rowIndex].description = 'SPARE';
      renderTable();
      renderValidation();
      renderPreview();
      saveState();
    }

    tableBody.addEventListener('input', handleRowUpdate);
    tableBody.addEventListener('change', handleRowUpdate);
    tableBody.addEventListener('click', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLButtonElement)) return;
      const insertIndex = Number(target.dataset.insertRowIndex);
      if (!Number.isNaN(insertIndex) && state.rows[insertIndex]) {
        state.rows.splice(insertIndex + 1, 0, createEmptyRow(0));
        state.rows = state.rows.map((row, index) => ({ ...row, circuit: String(index + 1) }));
        renderAll();
        saveState(`Inserted row after ${insertIndex + 1}.`);
        return;
      }

      const rowIndex = Number(target.dataset.deleteRowIndex);
      if (Number.isNaN(rowIndex) || !state.rows[rowIndex]) return;
      const confirmed = window.confirm(`Delete row ${rowIndex + 1}?`);
      if (!confirmed) return;
      state.rows.splice(rowIndex, 1);
      state.rows = state.rows.map((row, index) => ({ ...row, circuit: String(index + 1) }));
      renderAll();
      saveState(`Deleted row ${rowIndex + 1}.`);
    });

    exampleSelect.addEventListener('change', (event) => {
      const target = event.target;
      if (!(target instanceof HTMLSelectElement)) return;
      selectedExampleValue = target.value;
    });

    document.querySelector('#load-example').addEventListener('click', () => loadExample(exampleSelect.value));
    document.querySelector('#add-row').addEventListener('click', () => {
      state.rows.push(createEmptyRow(state.rows.length));
      renderAll();
      saveState('Added row.');
    });

    document.querySelector('#reset-sheet').addEventListener('click', () => {
      state = createInitialState();
      selectedExampleValue = '';
      renderAll();
      saveState('Sheet reset.');
    });
    document.querySelector('#download-sheet').addEventListener('click', () => {
      const html = buildOfficialSheetHtml();
      const blob = new Blob([html], { type: 'text/html' });
      const url = URL.createObjectURL(blob);
      const link = document.createElement('a');
      link.href = url;
      link.download = 'nek400-kursfortegnelse-sheet.html';
      document.body.append(link);
      link.click();
      link.remove();
      URL.revokeObjectURL(url);
      saveState('Downloaded printable sheet file.');
    });

    function printSheetOnly() {
      const html = buildOfficialSheetHtml();
      const frame = document.createElement('iframe');
      frame.style.position = 'fixed';
      frame.style.right = '0';
      frame.style.bottom = '0';
      frame.style.width = '0';
      frame.style.height = '0';
      frame.style.border = '0';
      document.body.append(frame);

      frame.srcdoc = html;
      frame.onload = () => {
        const win = frame.contentWindow;
        if (!win) {
          frame.remove();
          return;
        }

        const cleanup = () => frame.remove();
        win.addEventListener('afterprint', cleanup, { once: true });
        win.focus();
        win.print();

        // Fallback cleanup in case afterprint is not emitted.
        setTimeout(() => {
          if (frame.isConnected) frame.remove();
        }, 3000);
      };
    }

    document.querySelector('#print-sheet').addEventListener('click', printSheetOnly);

    renderAll();
  </script>
</BaseLayout>

