---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="NEK 400 Kursfortegnelse | Olinske"
  description="NEK 400-oriented kursfortegnelse builder with common circuit presets, local test examples, and core Ib/In/Iz validation."
>
  <main class="sheet-only-shell">
    <section class="toolbar-card">
      <div class="toolbar-row">
        <label class="toolbar-field">
          <span>Example</span>
          <select id="example-select">
            <option value="">Choose example</option>
          </select>
        </label>
        <label class="toolbar-field">
          <span>Sheet mode</span>
          <select id="sheet-mode">
            <option value="basic">Basic</option>
            <option value="advanced">Advanced (DSB-style)</option>
          </select>
        </label>
        <label class="toolbar-field">
          <span>Long text</span>
          <select id="description-flow">
            <option value="continue-row">Continue row (blank NR)</option>
            <option value="wrap">Wrap in same row</option>
            <option value="truncate">Truncate with ellipsis</option>
          </select>
        </label>
        <div class="toolbar-actions">
          <button id="load-example" type="button">Load example</button>
          <button id="add-row" type="button">Add row</button>
          <button id="reset-sheet" type="button">Reset</button>
          <button id="download-sheet" type="button">Download Sheet</button>
          <button id="print-sheet" type="button" class="accent">Print</button>
        </div>
      </div>
      <p id="save-status" class="status-line" aria-live="polite">Local autosave ready.</p>
    </section>

    <section class="editor-card">
      <div class="section-head">
        <div>
          <p class="section-kicker">Header</p>
          <h2>Project details</h2>
        </div>
      </div>
      <div id="meta-grid" class="meta-grid"></div>
    </section>

    <section class="editor-card">
      <div class="section-head">
        <div>
          <p class="section-kicker">Circuits</p>
          <h2>Kurs rows</h2>
          <p id="row-summary" class="status-line">Rows: 0</p>
        </div>
        <p id="validation-summary" class="status-line">No active findings.</p>
      </div>
      <div class="table-scroll">
        <table class="editor-table">
          <thead>
            <tr id="table-head"></tr>
          </thead>
          <tbody id="table-body"></tbody>
        </table>
      </div>
      <ul id="validation-list" class="validation-list"></ul>
    </section>

  </main>

  <article id="sheet-frame" class="print-sheet-host" aria-hidden="true"></article>

