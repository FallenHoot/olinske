---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts', ({ data }) => data.status === 'published' || data.status === 'scheduled'))
  .filter((post) => {
    const tags = post.data.tags ?? [];
    return tags.includes('cloud-architecture') || tags.includes('reliability') || tags.includes('bcdr') || tags.includes('azure');
  })
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
---

<BaseLayout
  title="Azure Resilience | Olinske"
  description="A curated reading path for Azure resilience, BCDR, and reliability operating models."
  canonicalUrl={Astro.site ? new URL('/azure-resilience/', Astro.site).toString() : '/azure-resilience/'}
>
  <main class="container site-shell">
    <section class="hero-panel fade-in">
      <p class="eyebrow">Topic Index</p>
      <h1 class="hero-title">Azure Resilience</h1>
      <p class="hero-subtitle">
        Read this track in order to move from redundancy choices to tested recovery design and operating ownership.
      </p>
    </section>

    <section class="about-panel fade-in fade-delay-1">
      <h2>How to use this page</h2>
      <p>
        Start with decision framing posts, then move to failure-mode analysis, then implementation and governance artifacts.
      </p>
    </section>

    <section class="about-panel fade-in fade-delay-2">
      <h2>Recommended reading order</h2>
      <ol>
        {posts.map((post) => (
          <li>
            <a href={`/posts/${post.data.slug ?? post.id.replace(/\.md$/, '')}/`}>{post.data.title}</a>
          </li>
        ))}
      </ol>
    </section>
  </main>
</BaseLayout>
